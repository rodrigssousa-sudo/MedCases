/* MedCases Pro — InfoPlist.strings (es)
 * Strings de permissão localizadas para Español.
 * iOS muestra estas cadenas en los pop-ups de permiso cuando el idioma
 * del dispositivo es español. Cubre todos los NSUsageDescription presentes
 * en Info.plist para cumplir con Apple Guideline 5.1.1.
 */

/* ── Cámara ─────────────────────────────────────────────────────────────── */
"NSCameraUsageDescription" = "MedCases utiliza las fotos y documentos que usted selecciona para extraer la información solicitada. El contenido seleccionado puede transmitirse de forma segura a la infraestructura remota de MedCases y a proveedores contratados de procesamiento de IA para este fin.";

/* ── Micrófono ─────────────────────────────────────────────────────────── */
"NSMicrophoneUsageDescription" = "MedCases Pro usa el micrófono para dictado clínico y funciones de grabación de audio. El dictado puede utilizar el reconocimiento de voz de iOS. La transcripción remota opcional requiere un consentimiento explícito separado y permanece desactivada hasta que se cumplan los controles de privacidad y retención exigidos.";

/* ── Reconocimiento de Voz ─────────────────────────────────────────────── */
"NSSpeechRecognitionUsageDescription" = "MedCases Pro utiliza el reconocimiento de voz de iOS para convertir el dictado clínico en texto cuando el profesional activa manualmente el dictado. La transcripción remota opcional de audio largo es una función separada y requiere un consentimiento explícito específico antes de cualquier procesamiento remoto.";

/* ── Biblioteca de Fotos (lectura) ────────────────────────────────────── */
"NSPhotoLibraryUsageDescription" = "MedCases utiliza las fotos y documentos que usted selecciona para extraer la información solicitada. El contenido seleccionado puede transmitirse de forma segura a la infraestructura remota de MedCases y a proveedores contratados de procesamiento de IA para este fin.";

/* ── Biblioteca de Fotos (escritura/guardar) ──────────────────────────── */
"NSPhotoLibraryAddUsageDescription" = "MedCases Pro puede guardar imágenes generadas por la app — como gráficos de seguimiento clínico o capturas de protocolos — directamente en su biblioteca de fotos, únicamente cuando usted lo solicite de forma explícita.";
