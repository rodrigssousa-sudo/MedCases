/* MedCases Pro — InfoPlist.strings (en)
 * Localized permission strings for English.
 * iOS displays these strings in permission pop-ups when the device
 * language is English. Covers all NSUsageDescription keys in Info.plist
 * for compliance with Apple Guideline 5.1.1.
 */

/* ── Camera ──────────────────────────────────────────────────────────────── */
"NSCameraUsageDescription" = "MedCases uses photos and documents you select to extract the information you request. Selected content may be securely transmitted to MedCases remote processing infrastructure and contracted AI processing providers for this purpose.";

/* ── Microphone ──────────────────────────────────────────────────────────── */
"NSMicrophoneUsageDescription" = "MedCases Pro uses the microphone for clinical dictation and audio recording features. Dictation may use iOS speech recognition. Optional remote transcription requires separate explicit consent and remains disabled unless required privacy and retention controls are satisfied.";

/* ── Speech Recognition ──────────────────────────────────────────────────── */
"NSSpeechRecognitionUsageDescription" = "MedCases Pro uses iOS speech recognition to convert clinical dictation to text when the professional manually activates dictation. Optional remote long-form transcription is a separate feature and requires separate explicit consent before any remote audio processing.";

/* ── Photo Library (read) ───────────────────────────────────────────────── */
"NSPhotoLibraryUsageDescription" = "MedCases uses photos and documents you select to extract the information you request. Selected content may be securely transmitted to MedCases remote processing infrastructure and contracted AI processing providers for this purpose.";

/* ── Photo Library (write/save) ─────────────────────────────────────────── */
"NSPhotoLibraryAddUsageDescription" = "MedCases Pro may save app-generated images — such as clinical tracking charts or protocol screenshots — directly to your photo library, only when you explicitly request it.";
