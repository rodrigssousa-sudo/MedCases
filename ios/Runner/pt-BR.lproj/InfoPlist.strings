/* MedCases Pro — InfoPlist.strings (pt-BR)
 * Strings de permissão localizadas para Português do Brasil.
 * iOS exibe estas strings nos pop-ups de permissão quando o idioma
 * do dispositivo é pt-BR. Cobre todos os NSUsageDescription presentes
 * no Info.plist para conformidade com Apple Guideline 5.1.1.
 */

/* ── Câmera ─────────────────────────────────────────────────────────────── */
"NSCameraUsageDescription" = "O MedCases Pro usa a câmera exclusivamente para que profissionais de saúde possam fotografar laudos laboratoriais e resultados de exames clínicos para extração automática de dados com auxílio de IA. As imagens são processadas apenas dentro do app e nunca são armazenadas ou compartilhadas com terceiros.";

/* ── Microfone ─────────────────────────────────────────────────────────── */
"NSMicrophoneUsageDescription" = "O MedCases Pro usa o microfone exclusivamente para permitir que profissionais de saúde ditem evoluções clínicas e anotações de prontuário por voz. O áudio é processado apenas localmente pelo sistema de reconhecimento de voz do iOS e nunca é armazenado, transmitido ou compartilhado com servidores externos.";

/* ── Reconhecimento de Voz ─────────────────────────────────────────────── */
"NSSpeechRecognitionUsageDescription" = "O MedCases Pro utiliza o reconhecimento de voz do iOS para transcrever ditados clínicos de profissionais de saúde — como evoluções de pacientes e anotações de plantão — convertendo a fala em texto dentro do prontuário. Nenhum áudio é enviado a servidores externos nem armazenado após a transcrição. O recurso é ativado apenas quando o profissional aciona manualmente o ditafone.";

/* ── Biblioteca de Fotos (leitura) ────────────────────────────────────── */
"NSPhotoLibraryUsageDescription" = "O MedCases Pro solicita acesso à sua biblioteca de fotos para que o profissional de saúde possa anexar imagens clínicas — como fotografias de lesões, resultados de exames ou documentos médicos — diretamente às anotações e fichas de pacientes. As imagens são usadas exclusivamente dentro do app e não são compartilhadas com terceiros.";

/* ── Biblioteca de Fotos (escrita/salvar) ─────────────────────────────── */
"NSPhotoLibraryAddUsageDescription" = "O MedCases Pro pode salvar imagens geradas pelo app — como gráficos de acompanhamento clínico ou capturas de protocolos — diretamente na sua biblioteca de fotos, somente quando você solicitar explicitamente.";
