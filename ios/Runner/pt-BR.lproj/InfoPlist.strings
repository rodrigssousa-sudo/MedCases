/* MedCases Pro — InfoPlist.strings (pt-BR)
 * Strings de permissão localizadas para Português do Brasil.
 * iOS exibe estas strings nos pop-ups de permissão quando o idioma
 * do dispositivo é pt-BR. Cobre todos os NSUsageDescription presentes
 * no Info.plist para conformidade com Apple Guideline 5.1.1.
 */

/* ── Câmera ─────────────────────────────────────────────────────────────── */
"NSCameraUsageDescription" = "O MedCases utiliza as fotos e documentos que você seleciona para extrair as informações solicitadas. O conteúdo selecionado pode ser transmitido de forma segura à infraestrutura remota do MedCases e a fornecedores contratados de processamento de IA para essa finalidade.";

/* ── Microfone ─────────────────────────────────────────────────────────── */
"NSMicrophoneUsageDescription" = "O MedCases Pro usa o microfone para ditado clínico e recursos de gravação de áudio. O ditado pode utilizar o reconhecimento de voz do iOS. A transcrição remota opcional exige consentimento explícito separado e permanece desativada até que os controles exigidos de privacidade e retenção sejam atendidos.";

/* ── Reconhecimento de Voz ─────────────────────────────────────────────── */
"NSSpeechRecognitionUsageDescription" = "O MedCases Pro utiliza o reconhecimento de voz do iOS para converter ditado clínico em texto quando o profissional ativa manualmente o ditado. A transcrição remota opcional de áudio longo é um recurso separado e exige consentimento explícito específico antes de qualquer processamento remoto.";

/* ── Biblioteca de Fotos (leitura) ────────────────────────────────────── */
"NSPhotoLibraryUsageDescription" = "O MedCases utiliza as fotos e documentos que você seleciona para extrair as informações solicitadas. O conteúdo selecionado pode ser transmitido de forma segura à infraestrutura remota do MedCases e a fornecedores contratados de processamento de IA para essa finalidade.";

/* ── Biblioteca de Fotos (escrita/salvar) ─────────────────────────────── */
"NSPhotoLibraryAddUsageDescription" = "O MedCases Pro pode salvar imagens geradas pelo app — como gráficos de acompanhamento clínico ou capturas de protocolos — diretamente na sua biblioteca de fotos, somente quando você solicitar explicitamente.";
