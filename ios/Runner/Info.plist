<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MedCases Pro</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MedCases Pro</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ══════════════════════════════════════════════════════════════════════
	     PRIVACY USAGE DESCRIPTIONS — FALLBACK (English)
	     These are the fallback strings shown on devices with unsupported
	     locales. Localized strings for pt-BR, es and en are in their
	     respective *.lproj/InfoPlist.strings files.
	     Apple Review guideline 5.1.1: all strings must match the device
	     language — the .lproj files handle PT and ES; this English fallback
	     satisfies the requirement for any other locale.
	     ══════════════════════════════════════════════════════════════════════ -->

	<!-- Camera: used to photograph lab reports and exam results for AI extraction -->
	<key>NSCameraUsageDescription</key>
	<string>MedCases Pro uses the camera exclusively to allow healthcare professionals to photograph laboratory reports and clinical exam results for automatic AI-assisted data extraction. Images are processed only within the app and are never stored or shared with third parties.</string>

	<!-- Microphone: used exclusively for clinical dictation (speech-to-text) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>MedCases Pro uses the microphone exclusively to allow healthcare professionals to dictate clinical notes and medical records by voice. Audio is processed locally by the iOS speech recognition system and is never stored, transmitted, or shared with external servers.</string>

	<!-- Speech Recognition: used to transcribe clinical dictations into text -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>MedCases Pro uses iOS speech recognition strictly to transcribe clinical dictations from healthcare professionals — such as patient progress notes and shift annotations — converting speech to text within the medical record. No audio is sent to external servers or stored after transcription. The feature is activated only when the professional manually enables the dictaphone.</string>

	<!-- Photo Library (read): used to attach clinical images to patient notes -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MedCases Pro requests access to your photo library so healthcare professionals can attach relevant clinical images — such as photos of lesions, exam results, or medical documents — directly to patient notes. Images are used exclusively within the app and are not shared with third parties.</string>

	<!-- Photo Library (write): used to save generated charts or protocol screenshots -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>MedCases Pro may save app-generated images — such as clinical tracking charts or protocol screenshots — directly to your photo library, only when you explicitly request it.</string>

	<!-- ── ATT removed — app does not use third-party tracking or advertising SDKs -->
	<!-- NSUserTrackingUsageDescription REMOVED: no Firebase Analytics,      -->
	<!-- no IDFA, no advertising SDKs. Compliance: Apple Guideline 5.1.2.    -->
	<!-- Declare "No data used to track you" in App Store Connect Privacy.    -->

	<!-- ── Orientação iPhone: somente portrait ───────────────────────────── -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- ── Orientação iPad: portrait + landscape (Apple HIG 4.0 multitasking) ── -->
	<!-- UIRequiresFullScreen REMOVIDA para habilitar Split View / Slide Over.  -->
	<!-- Apple exige suporte a landscape no iPad para aprovação na App Store.   -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ── Modos de background ───────────────────────────────────────────── -->
	<!-- audio: exigido pelo speech_to_text para manter sessão STT ativa      -->
	<!-- fetch: permite que flutter_local_notifications dispare no background -->
	<!-- remote-notification: para FCM push (futuro firebase_messaging)       -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

	<!-- ── Launch / Main storyboard ─────────────────────────────────────── -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- ── Performance e acessibilidade ─────────────────────────────────── -->
	<!-- ProMotion: desabilita limite de 60fps em iPhones com tela de 120Hz  -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Suporte a trackpad/mouse via iPad (Magic Keyboard, Pencil, etc.)    -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ── Google Sign-In ────────────────────────────────────────────────── -->
	<!-- GIDClientID: OAuth 2.0 client ID do projeto Firebase (iOS)          -->
	<key>GIDClientID</key>
	<string>1076800980330-h06p1o1t4ll48qsqk5ovkfse8e0t98g0.apps.googleusercontent.com</string>
	<!-- CFBundleURLTypes: URL Scheme reverso para callback OAuth do Google   -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1076800980330-h06p1o1t4ll48qsqk5ovkfse8e0t98g0</string>
			</array>
		</dict>
	</array>

	<!-- ── Criptografia ──────────────────────────────────────────────────── -->
	<!-- false = app usa apenas HTTPS padrão do iOS (sem criptografia própria)-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
