<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MedCases Pro</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MedCases Pro</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ── Privacidade ───────────────────────────────────────────────────── -->
	<!-- Microfone: flutter_tts usa AVAudioSession para síntese de voz       -->
	<key>NSMicrophoneUsageDescription</key>
	<string>O MedCases Pro usa o microfone para reconhecimento de voz durante a criação de anotações clínicas e interação com a IA.</string>
	<!-- Reconhecimento de voz: STT para transcrição de anotações clínicas   -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>O MedCases Pro usa reconhecimento de voz para transcrever anotações clínicas por voz de forma rápida e precisa.</string>

	<!-- ── Orientação iPhone: somente portrait ───────────────────────────── -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- ── Orientação iPad: todas as orientações (obrigatório para iPad) ─── -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ── Launch / Main storyboard ─────────────────────────────────────── -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- ── Performance e acessibilidade ─────────────────────────────────── -->
	<!-- ProMotion: desabilita limite de 60fps em iPhones com tela de 120Hz  -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Suporte a trackpad/mouse via iPad (Magic Keyboard, Pencil, etc.)    -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ── Criptografia ──────────────────────────────────────────────────── -->
	<!-- false = app usa apenas HTTPS padrão do iOS (sem criptografia própria)-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
