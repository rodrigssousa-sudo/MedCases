<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MedCases Pro</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MedCases Pro</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ── Privacidade ───────────────────────────────────────────────────── -->
	<!-- Microfone: exclusivamente para ditado de evolução clínica (STT)     -->
	<key>NSMicrophoneUsageDescription</key>
	<string>MedCases Pro precisa acessar o microfone exclusivamente para permitir que o profissional médico dite evoluções clínicas e anotações do prontuário por voz, convertendo a fala em texto diretamente no dispositivo. O áudio é processado apenas localmente pelo sistema de reconhecimento de voz do iOS e não é armazenado, transmitido ou compartilhado com servidores externos.</string>
	<!-- Reconhecimento de voz: transcrição local de anotações clínicas      -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>MedCases Pro utiliza o reconhecimento de voz do iOS estritamente para transcrever ditados clínicos de profissionais de saúde — como evoluções de pacientes e anotações de plantão — transformando a fala em texto dentro do prontuário. Nenhum áudio é enviado a servidores externos nem armazenado após a transcrição. O recurso é ativado apenas quando o profissional aciona manualmente o ditafone.</string>

	<!-- ── Orientação iPhone: somente portrait ───────────────────────────── -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- ── Orientação iPad: todas as orientações (obrigatório para iPad) ─── -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ── Launch / Main storyboard ─────────────────────────────────────── -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- ── Performance e acessibilidade ─────────────────────────────────── -->
	<!-- ProMotion: desabilita limite de 60fps em iPhones com tela de 120Hz  -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Suporte a trackpad/mouse via iPad (Magic Keyboard, Pencil, etc.)    -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ── Google Sign-In ────────────────────────────────────────────────── -->
	<!-- GIDClientID: OAuth 2.0 client ID do projeto Firebase (iOS)          -->
	<key>GIDClientID</key>
	<string>1076800980330-h06p1o1t4ll48qsqk5ovkfse8e0t98g0.apps.googleusercontent.com</string>
	<!-- CFBundleURLTypes: URL Scheme reverso para callback OAuth do Google   -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1076800980330-h06p1o1t4ll48qsqk5ovkfse8e0t98g0</string>
			</array>
		</dict>
	</array>

	<!-- ── Criptografia ──────────────────────────────────────────────────── -->
	<!-- false = app usa apenas HTTPS padrão do iOS (sem criptografia própria)-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
