<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MedCases Pro</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MedCases Pro</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ── Privacidade ───────────────────────────────────────────────────── -->
	<!-- Microfone: exclusivamente para ditado de evolução clínica (STT)     -->
	<key>NSMicrophoneUsageDescription</key>
	<string>MedCases Pro precisa acessar o microfone exclusivamente para permitir que o profissional médico dite evoluções clínicas e anotações do prontuário por voz, convertendo a fala em texto diretamente no dispositivo. O áudio é processado apenas localmente pelo sistema de reconhecimento de voz do iOS e não é armazenado, transmitido ou compartilhado com servidores externos.</string>
	<!-- Reconhecimento de voz: transcrição local de anotações clínicas      -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>MedCases Pro utiliza o reconhecimento de voz do iOS estritamente para transcrever ditados clínicos de profissionais de saúde — como evoluções de pacientes e anotações de plantão — transformando a fala em texto dentro do prontuário. Nenhum áudio é enviado a servidores externos nem armazenado após a transcrição. O recurso é ativado apenas quando o profissional aciona manualmente o ditafone.</string>

	<!-- ── Biblioteca de fotos ───────────────────────────────────────────── -->
	<!-- file_picker 8.x e share_plus 12.x exigem esta key — crash sem ela    -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MedCases Pro solicita acceso a su biblioteca de fotos únicamente para que el profesional de salud pueda adjuntar imágenes clínicas relevantes — como fotografías de lesiones, resultados de exámenes o documentos médicos — directamente a sus anotaciones y fichas de pacientes. Las imágenes se utilizan exclusivamente dentro de la aplicación y no se comparten con terceros.</string>

	<!-- NSPhotoLibraryAddUsageDescription: exigida pelo share_plus ao salvar  -->
	<!-- imagens no rolo da câmera (ex.: exportar gráfico ou PDF como imagem)  -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>MedCases Pro puede guardar imágenes generadas por la aplicación — como gráficos de seguimiento clínico o capturas de protocolos — directamente en su biblioteca de fotos, exclusivamente cuando usted lo solicite de forma explícita.</string>

	<!-- ── Orientação iPhone: somente portrait ───────────────────────────── -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- ── Orientação iPad: somente portrait (app não foi projetado para landscape) -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>

	<!-- ── Tela cheia no iPad ───────────────────────────────────────────── -->
	<!-- Informa à App Store que o app requer tela cheia (não suporta        -->
	<!-- multitarefa Split View / Slide Over do iPad). Sem esta chave, a     -->
	<!-- Apple exige que UISupportedInterfaceOrientations~ipad inclua todas  -->
	<!-- as 4 orientações — erro de upload code 90474 (Invalid bundle).      -->
	<key>UIRequiresFullScreen</key>
	<true/>

	<!-- ── Modos de background ───────────────────────────────────────────── -->
	<!-- audio: exigido pelo speech_to_text para manter sessão STT ativa      -->
	<!-- quando o app vai para background durante ditado clínico              -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- ── Launch / Main storyboard ─────────────────────────────────────── -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- ── Performance e acessibilidade ─────────────────────────────────── -->
	<!-- ProMotion: desabilita limite de 60fps em iPhones com tela de 120Hz  -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Suporte a trackpad/mouse via iPad (Magic Keyboard, Pencil, etc.)    -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ── Google Sign-In ────────────────────────────────────────────────── -->
	<!-- GIDClientID: OAuth 2.0 client ID do projeto Firebase (iOS)          -->
	<key>GIDClientID</key>
	<string>1076800980330-h06p1o1t4ll48qsqk5ovkfse8e0t98g0.apps.googleusercontent.com</string>
	<!-- CFBundleURLTypes: URL Scheme reverso para callback OAuth do Google   -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1076800980330-h06p1o1t4ll48qsqk5ovkfse8e0t98g0</string>
			</array>
		</dict>
	</array>

	<!-- ── Criptografia ──────────────────────────────────────────────────── -->
	<!-- false = app usa apenas HTTPS padrão do iOS (sem criptografia própria)-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
