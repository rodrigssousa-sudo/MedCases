<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MedCases Pro</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MedCases Pro</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>O MedCases Pro pode usar a câmera para digitalizar documentos clínicos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>O MedCases Pro pode acessar fotos para anexar documentos clínicos.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Privacidade: microfone e reconhecimento de voz (flutter_tts + STT) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>O MedCases Pro usa o microfone para reconhecimento de voz durante a criação de histórias clínicas e interação com a IA.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>O MedCases Pro usa reconhecimento de voz para transcrever suas anotações clínicas por voz de forma rápida.</string>

	<!-- URL Schemes para Google Sign-In (google_sign_in no iOS)            -->
	<!-- AÇÃO NECESSÁRIA: substitua o valor abaixo pelo REVERSED_CLIENT_ID  -->
	<!-- do seu GoogleService-Info.plist (baixe versão completa no Firebase  -->
	<!-- Console > Project Settings > iOS app > GoogleService-Info.plist)   -->
	<!-- Formato: com.googleusercontent.apps.XXXXXXXXXX-YYYYY               -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- TODO: substituir pelo REVERSED_CLIENT_ID do GoogleService-Info.plist -->
				<string>com.medcasespro.med</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
