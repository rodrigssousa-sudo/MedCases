<?xml version="1.0" encoding="utf-8"?>
<!-- Release/default resource: every origin requires TLS. Debug overrides this
     resource by Android source-set precedence, not by runtime authority flags. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
