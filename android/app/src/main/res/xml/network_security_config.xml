<?xml version="1.0" encoding="utf-8"?>
<!--
  network_security_config.xml — MedCases Pro
  BUILD 313: Habilita tráfego cleartext HTTP na base-config.

  OBJETIVO:
    • Permite tráfego HTTP não-criptografado para requisições locais/customizadas
      que o Android bloqueava mesmo com Firebase e Firestore liberados.
    • Domínios de produção continuam com HTTPS obrigatório via domain-config.
    • Compatível com Android API 24+ (Nougat) e versões superiores.

  CONTEXTO (BUILD 283 → BUILD 313):
    No Android API 24+, a política padrão de segurança de rede proíbe cleartext
    HTTP. O flag cleartextTrafficPermitted="true" na base-config permite HTTP
    genérico enquanto os domínios de produção mantêm HTTPS forçado via
    domain-config (que sobrescreve a base-config por especificidade).
    O atributo android:usesCleartextTraffic="true" no AndroidManifest.xml
    complementa esta configuração para APIs Android mais antigas (< 24).

  SEGURANÇA:
    • Domínios de produção MedCases (medcasespro.com, googleapis.com etc.)
      mantêm HTTPS obrigatório via domain-config específica.
    • file:// tratado como localhost — sem acesso cross-origin a http/https.
-->
<network-security-config>
    <!--
      Política base: cleartext HTTP habilitado para compatibilidade com
      requisições locais/customizadas do app (BUILD 313).
      Domínios de produção sobrescrevem esta política via domain-config abaixo.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Domínios de produção MedCases — HTTPS obrigatório, certificados do sistema.
      includeSubdomains="true" cobre www.medcasescalcu.com, api.medcasespro.com, etc.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">medcasespro.com</domain>
        <domain includeSubdomains="true">medcasescalcu.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">firebase.com</domain>
        <domain includeSubdomains="true">firebaseapp.com</domain>
        <domain includeSubdomains="true">firebaseio.com</domain>
        <domain includeSubdomains="true">gstatic.com</domain>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
