# ══════════════════════════════════════════════════════════════════════════════
# MedCases Pro — AI Gateway Server
# Variáveis de Ambiente
# ══════════════════════════════════════════════════════════════════════════════
#
# INSTRUÇÃO: Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env
#
# No Digital Ocean App Platform, configure as variáveis via painel/CLI —
# NÃO commite o .env com valores reais no git.
# ══════════════════════════════════════════════════════════════════════════════

# ── OBRIGATÓRIA ───────────────────────────────────────────────────────────────
# Chave de API do Google Gemini (obtida em: https://aistudio.google.com/apikey)
GEMINI_API_KEY=sua_chave_aqui

# ── OPCIONAIS (valores padrão mostrados) ─────────────────────────────────────

# Porta HTTP do servidor
PORT=8080

# Domínio do Flutter Web (para CORS)
ALLOWED_ORIGIN=https://medcasespro.com

# Ambiente de execução
NODE_ENV=production

# Nível de log: silent | info | debug
LOG_LEVEL=info
