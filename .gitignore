#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
# build/ — CASE A Source-Build Framework (DigitalOcean Dockerfile compiles at deploy time)
# build/web/ artifacts are produced by the DO multi-stage Dockerfile — never commit them.
# DO Stage 1 runs: flutter build web --release --dart-define=BUILD_COMMIT=... etc.
# Committing build/web/ would create staleness risk and inflate repo size unnecessarily.
build/android/
build/app/
build/ios/
build/linux/
build/macos/
build/windows/
build/flutter_assets/
build/unit_test_assets/
build/native_assets/
build/test_cache/
# Artefatos de build Android/plugins (não commitar)
build/.cxx/
build/reports/
build/*.dill
build/*.dill.track.dill
build/cloud_firestore/
build/firebase_auth/
build/firebase_core/
build/flutter_local_notifications/
build/path_provider_android/
build/share_plus/
build/shared_preferences_android/
build/url_launcher_android/
build/[0-9a-f]*/
# Web build artifacts — compiled by DO Dockerfile, never tracked in git
build/web/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing — NUNCA commitar keystore nem key.properties
android/key.properties
android/release-key.jks
*.jks
*.keystore

