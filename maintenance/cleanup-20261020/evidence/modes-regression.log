              '          ),\n'
              '          \'\',\n'
              '        )\n'
              '        .trim();\n'
              '\n'
              '    return folded;\n'
              '  }\n'
              '\n'
              '  String _extractTopicSignature(String query) {\n'
              '    final canonicalQuery = _stripStudyPedagogicalLead(query);\n'
              '    if (canonicalQuery.isEmpty) return \'\';\n'
              '\n'
              '    final words = canonicalQuery\n'
              '        .split(RegExp(r\'\\s+\'))\n'
              '        // M77_CLINICAL_TOPIC_GENERIC_PATIENT_TOKEN_FILTER_V1\n'
              '        .where(\n'
              '          (w) =>\n'
              '              w.length > 3 &&\n'
              '              !_kStopwords.contains(w) &&\n'
              '              !const <String>{\n'
              '                \'paciente\',\n'
              '                \'pacientes\',\n'
              '                \'patient\',\n'
              '                \'patients\',\n'
              '                // M77_SHORT_PROMPT_GENERIC_TASK_TOKEN_FILTER_V1\n'
              '                \'conduta\',\n'
              '                \'conducta\',\n'
              '                \'imediata\',\n'
              '                \'imediato\',\n'
              '                \'inmediata\',\n'
              '                \'inmediato\',\n'
              '                \'immediate\',\n'
              '                \'management\',\n'
              '              }.contains(w),\n'
              '        )\n'
              '        .take(6)\n'
              '        .toList();\n'
              '\n'
              '    return words.join(\'_\');\n'
              '  }\n'
              '\n'
              '  /// Verifica overlap temático — BUILD 305 [C1]: varredura bidirecional em 3 camadas.\n'
              '  ///\n'
              '  /// PROBLEMA ORIGINAL: apenas Set.intersection falhava em inversões sintáticas\n'
              '  /// e morfologia flexionada (ex: "congestão" vs "congestionamento").\n'
              '  ///\n'
              '  /// SOLUÇÃO EM 3 CAMADAS:\n'
              '  ///   Camada 1 — Set.intersection (O(n), rápido): sobreposição direta de tokens.\n'
              '  ///   Camada 2 — Varredura direta: token do tópico ativo contido na nova query\n'
              '  ///              (substring). Captura morfologia, siglas expandidas.\n'
              '  ///   Camada 3 — Varredura reversa [NOVO]: token longo da nova query contido\n'
              '  ///              no tópico ativo. Impede amnésia por inversão de ordem das\n'
              '  ///              palavras ("congestão pulmonar" ↔ "congestao_pulmonar_ic").\n'
              '  bool _topicsOverlap(String activeTopic, String newQuery) {\n'
              '    activeTopic = _canonicalizePlantaoTopicAliases(activeTopic);\n'
              '    newQuery = _canonicalizePlantaoTopicAliases(newQuery);\n'
              '\n'
              '    if (activeTopic.isEmpty) return false;\n'
              '    final topicWords = Set<String>.from(activeTopic.split(\'_\'));\n'
              '    final qLower = newQuery.toLowerCase().replaceAll(RegExp(r\'[^\\w\\s]\'), \' \');\n'
              '    final queryWords = qLower\n'
              '        .split(RegExp(r\'\\s+\'))\n'
              '        .where((w) => w.length > 3 && !_kStopwords.contains(w))\n'
              '        .toSet();\n'
              '\n'
              '    // Camada 1: interseção direta de conjuntos\n'
              '    if (topicWords.intersection(queryWords).isNotEmpty) return true;\n'
              '\n'
              '    // Camada 2: palavra do tópico contida na query (substring) — morfologia\n'
              '    for (final tw in topicWords) {\n'
              '      if (tw.length > 4 && qLower.contains(tw)) return true;\n'
              '    }\n'
              '\n'
              '    // Camada 3 [BUILD 305 C1]: palavra longa da query contida no tópico ativo\n'
              '    // Resolve inversões sintáticas: "congestão pulmonar" ↔ "congestao_pulmonar_ic"\n'
              '    final topicFlat = activeTopic.replaceAll(\'_\', \' \');\n'
              '    for (final qw in queryWords) {\n'
              '      if (qw.length > 4 && topicFlat.contains(qw)) return true;\n'
              '    }\n'
              '\n'
              '    return false;\n'
              '  }\n'
              '\n'
              '  /// Detecta fármaco primário na query\n'
              '  String? _detectPrimaryDrug(String text) {\n'
              '    for (final drug in _kHighSpecificityDrugs) {\n'
              '      if (text.contains(drug)) return drug;\n'
              '    }\n'
              '    return null;\n'
              '  }\n'
              '}\n'
