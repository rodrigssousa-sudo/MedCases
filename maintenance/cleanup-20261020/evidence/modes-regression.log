              '//   2. isContinuationOfCurrentThread() — detecta se é follow-up ou novo caso\n'
              '//   3. buildHistoryStrategy() — decide quantos turnos de history enviar ao Gemini\n'
              '//   4. Integrado ao fluxo em app_provider.dart (sendAiMessage + buildAIAnswer)\n'
              '//\n'
              '// REGRAS DE CONTEXTO (Modo Plantão):\n'
              '//   isContinuation=true  → enviar últimas 1-3 interações do thread atual\n'
              '//   isContinuation=false → enviar histórico VAZIO, iniciar novo thread\n'
              '//\n'
              '// LOG:\n'
              '//   [THREAD_MANAGER] mode=plantao action=new_thread reason=topic_shift\n'
              '//                    oldTopic=amiodarona newTopic=gastroenterite\n'
              '//   [THREAD_MANAGER] mode=plantao action=continue_thread reason=button_action\n'
              '//                    topic=TEP turnCount=2\n'
              '//   [THREAD_AUDIT] foundExisting=true components=ClinicalSessionMemory,_aiHistory\n'
              '//   [HISTORY_SANITIZER] mode=plantao strategy=empty sent=0 removed=N\n'
              '//   [HISTORY_SANITIZER] mode=plantao strategy=thread_minimal sent=2 topic=TEP\n'
              '//   [EXT_TOOL_CONTEXT] source=current_only q=diarreia\n'
              '//   [EXT_TOOL_CONTEXT] blocked_stale_tool old=amiodarona reason=not_in_current_context\n'
              '// ══════════════════════════════════════════════════════════════════════════════\n'
              '\n'
              'import \'package:flutter/foundation.dart\' show debugPrint, kDebugMode;\n'
              '\n'
              '// ─────────────────────────────────────────────────────────────────────────────\n'
              '// ClinicalThreadStatus — resultado da detecção de continuidade\n'
              '// ─────────────────────────────────────────────────────────────────────────────\n'
              'enum ThreadAction {\n'
              '  continueThread, // follow-up do caso ativo → enviar histórico mínimo\n'
              '  newThread, // novo caso / tema diferente → limpar histórico\n'
              '}\n'
              '\n'
              'class ClinicalThreadStatus {\n'
              '  final ThreadAction action;\n'
              '  final String reason; // para log\n'
              '  final String topic; // tópico ativo (novo ou mantido)\n'
              '  final bool fromButton; // veio de botão clínico\n'
              '\n'
              '  const ClinicalThreadStatus({\n'
              '    required this.action,\n'
              '    required this.reason,\n'
              '    required this.topic,\n'
              '    this.fromButton = false,\n'
              '  });\n'
              '\n'
              '  bool get isContinuation => action == ThreadAction.continueThread;\n'
              '}\n'
              '\n'
              '// ─────────────────────────────────────────────────────────────────────────────\n'
              '// ClinicalThreadManager — rastreador de thread clínico ativo\n'
              '//\n'
              '// 100% LOCAL — RAM-only — Zero rede — Zero IA\n'
              '// ─────────────────────────────────────────────────────────────────────────────\n'
              'class ClinicalThreadManager {\n'
              '  // ── Estado do thread ativo ─────────────────────────────────────────────────\n'
              '  String _activeTopic = \'\';\n'
              '  String _activeThreadId = \'\';\n'
              '  int _turnCount = 0;\n'
              '  int _lastActivityMs = 0;\n'
              '\n'
              '  // Última pergunta do usuário que INICIOU o thread ativo\n'
              '  String _threadStartQuery = \'\';\n'
              '\n'
              '  // Máximo de turnos de histórico a enviar em modo continuation\n'
              '  // ORDEM 19: reduzido para 2 pares (= 4 entradas) — payload enxuto, máxima velocidade.\n'
              '  // Lógica: 1 par anterior (user+assistant) + query atual = contexto mínimo eficaz.\n'
              '  // Evita avalanche de tokens redundantes sem perder continuidade do turno imediato.\n'
              '  static const int kMaxContinuationTurns =\n'
              '      2; // 2 pares user/assistant = 4 entradas\n'
              '\n'
              '  // Timeout de inatividade: 10 minutos sem mensagem → novo thread automaticamente (Plantão)\n'
              '  static const int kThreadTimeoutMs = 10 * 60 * 1000;\n'
              '\n'
              '  // BUILD 304 [G3]: TTL de inatividade para Modo Estudo.\n'
              '  // Se o médico ficar mais de 6h sem interagir, o histórico de transporte da\n'
              '  // sessão de Estudo é descartado — evita continuidade pedagógica incoerente\n'
              '  // (médico esqueceu o contexto; nova sessão começa limpa).\n'
              '  // O histórico LOCAL no dispositivo é PRESERVADO para exibição visual.\n'
              '  // Study transport memory is bounded by 30 exchanges, not TTL-cleared inside an active chat.\n'
              '\n'
              '  // BUILD 304 [G1]: Janela micro-deslizante para Modo Estudo.\n'
              '  // Médicos em Estudo realizam no máximo 4-5 interações por tema.\n'
              '  // Enviar histórico completo (10+ turnos) é desperdício crítico de tokens.\n'
              '  // Máx 4 turnos (2 pares user+assistant = 4 entradas) no payload da API.\n'
              '  // O histórico completo permanece intacto no dispositivo para exibição.\n'
              '  static const int kMaxStudyTurns = 30; // 30 pares = 60 entradas\n'
              '\n'
              '  // ── Frases que sempre indicam follow-up (nunca iniciam novo thread) ────────\n'
              '  static const _kFollowUpPhrases = <String>{\n'
              '    // PT-BR — respostas a pergunta interativa\n'
              '    \'sim\', \'não\', \'nao\', \'ok\', \'certo\', \'entendido\', \'confirma\', \'confirmo\',\n'
              '    // PT-BR — continuação explícita\n'
              '    \'dose\', \'a dose\', \'qual a dose\', \'qual dose\', \'e a dose\',\n'
              '    \'monitorar\', \'monitorização\', \'monitorizacao\',\n'
              '    \'contraindicação\', \'contraindicacao\', \'contraindicações\',\n'
              '    \'alternativa\', \'alternativas\',\n'
              '    \'diluição\', \'diluicao\', \'como dilui\', \'como diluir\',\n'
              '    \'infusão\', \'como infundir\',\n'
              '    \'e agora\', \'o que fazer\', \'próximo passo\', \'proximo passo\',\n'
              '    \'detalhar\', \'mais detalhes\', \'pode detalhar\', \'me explica\',\n'
              '    \'conduta\', \'condutas\', \'e a conduta\', \'qual a conduta\',\n'
              '    \'interação\', \'interacao\',\n'
              '    \'como funciona\', \'mecanismo\',\n'
              '    // ES (only entries NOT already in PT-BR above)\n'
              '    \'sí\', \'si\',\n'
              '    \'dosis\', \'la dosis\', \'cuál es la dosis\',\n'
              '    \'monitorizar\', \'monitoreo\',\n'
              '    \'contraindicación\',\n'
              '    \'dilución\', \'infusión\',\n'
              '    \'qué hacer\', \'siguiente paso\', \'próximo paso\',\n'
              '    \'detallar\', \'más detalles\', \'explica\',\n'
              '    \'interacción\',\n'
              '  };\n'
              '\n'
              '  // ── Follow-ups clínicos contextuais com dados novos ───────────────────────\n'
              '  //\n'
              '  // Reconhece mensagens que acrescentam dados ao caso ativo sem repetir a\n'
              '  // patologia: peso/ajuste renal, história dirigida, sinais vitais,\n'
              '  // laboratório e imagem. Uma introdução explícita de novo paciente/caso não\n'
              '  // é convertida em continuação.\n'
              '  static bool isContextualClinicalFollowUp(String text) {\n'
              '    var q = text.trim().toLowerCase();\n'
              '    if (q.isEmpty) return false;\n'
              '    q = q.replaceFirst(RegExp(r\'^[¿¡\\s]+\'), \'\');\n'
              '\n'
              '    // PT/ES: dobra acentos apenas para classificação lexical. O texto original\n'
              '    // continua intacto no histórico e no payload enviado ao provider.\n'
              '    final qFolded = q\n'
              '        .replaceAll(\'á\', \'a\')\n'
              '        .replaceAll(\'é\', \'e\')\n'
              '        .replaceAll(\'í\', \'i\')\n'
              '        .replaceAll(\'ó\', \'o\')\n'
              '        .replaceAll(\'ú\', \'u\')\n'
              '        .replaceAll(\'ü\', \'u\')\n'
              '        .replaceAll(\'ç\', \'c\');\n'
              '    final lexicalTokens = RegExp(r\'[a-z0-9]+\')\n'
              '        .allMatches(qFolded)\n'
              '        .map((match) => match.group(0)!)\n'
              '        .toList(growable: false);\n'
              '\n'
              '    final explicitNewCase = <String>[\n'
              '      \'novo caso\',\n'
              '      \'nova paciente\',\n'
              '      \'novo paciente\',\n'
              '      \'outro paciente\',\n'
              '      \'outra paciente\',\n'
              '      \'mudar de caso\',\n'
              '      \'trocar de caso\',\n'
              '      \'nuevo caso\',\n'
              '      \'nuevo paciente\',\n'
              '      \'nueva paciente\',\n'
              '      \'otro paciente\',\n'
              '      \'otra paciente\',\n'
              '      \'cambiar de caso\',\n'
              '    ].any(qFolded.contains);\n'
              '    if (explicitNewCase) return false;\n'
              '\n'
              '    // PLANTAO_DEPENDENT_MANAGEMENT_FOLLOWUP_V1\n'
              '    //\n'
              '    // Perguntas de manejo que dependem do paciente ativo frequentemente nao\n'
              '    // repetem a patologia: "¿Y qué tratamiento farmacológico completo\n'
              '    // indicarías ahora?". Elas devem carregar o caso atual. A decisao final\n'
              '    // continua protegida pelas fronteiras canonicas: novo paciente/caso,\n'
              '    // patologia explicitamente diferente e troca inequivoca de farmaco.\n'
              '    final hasManagementTerm = <String>[\n'
              '      \'tratamiento\',\n'
              '      \'tratamento\',\n'
              '      \'manejo\',\n'
              '      \'conducta\',\n'
              '      \'conduta\',\n'
              '      \'prescripcion\',\n'
              '      \'prescricao\',\n'
              '      \'medicacion\',\n'
              '      \'medicacao\',\n'
              '    ].any(qFolded.contains);\n'
              '\n'
              '    final hasDependentManagementCue =\n'
              '        qFolded.startsWith(\'y \') ||\n'
              '        qFolded.startsWith(\'e \') ||\n'
              '        qFolded.contains(\' ahora\') ||\n'
              '        qFolded.endsWith(\'ahora\') ||\n'
              '        qFolded.contains(\' agora\') ||\n'
              '        qFolded.endsWith(\'agora\') ||\n'
              '        qFolded.contains(\'indicarias\') ||\n'
              '        qFolded.contains(\'indicaria\') ||\n'
              '        qFolded.contains(\'harias\') ||\n'
              '        qFolded.contains(\'haria\') ||\n'
              '        qFolded.contains(\'farias\') ||\n'
              '        qFolded.contains(\'faria\') ||\n'
              '        qFolded.contains(\'completo\') ||\n'
              '        qFolded == \'tratamiento\' ||\n'
              '        qFolded == \'tratamiento farmacologico\' ||\n'
              '        qFolded == \'tratamento\' ||\n'
              '        qFolded == \'tratamento farmacologico\' ||\n'
              '        qFolded == \'manejo\' ||\n'
              '        qFolded == \'conducta\' ||\n'
              '        qFolded == \'conduta\';\n'
              '\n'
              '    if (hasManagementTerm && hasDependentManagementCue) {\n'
              '      return true;\n'
              '    }\n'
              '\n'
              '    // PLANTAO_DEPENDENT_CLINICAL_FOLLOWUP_AND_CASE_ANCHOR_V1\n'
              '    //\n'
              '    // Follow-up clinico dependente nao e sinonimo de "classificacao".\n'
              '    // Perguntas curtas como "por que essa categoria?", "precisa internar?",\n'
              '    // "y trombolisis?" ou "en este paciente..." dependem do caso ativo.\n'
              '    //\n'
              '    // Fail-closed:\n'
              '    // - explicitNewCase continua tendo precedencia e ja retornou false acima;\n'
              '    // - frases exatas dependentes sao aceitas;\n'
              '    // - expansao semantica so ocorre quando existe referencia deitica explicita\n'
              '    //   ao caso anterior (este/ese/essa/eso/isso etc.).\n'
              '    final dependentClinicalQuery = qFolded\n'
              '        .replaceAll(\'á\', \'a\')\n'
              '        .replaceAll(\'à\', \'a\')\n'
              '        .replaceAll(\'â\', \'a\')\n'
              '        .replaceAll(\'ã\', \'a\')\n'
              '        .replaceAll(\'ä\', \'a\')\n'
              '        .replaceAll(\'é\', \'e\')\n'
              '        .replaceAll(\'è\', \'e\')\n'
              '        .replaceAll(\'ê\', \'e\')\n'
              '        .replaceAll(\'ë\', \'e\')\n'
              '        .replaceAll(\'í\', \'i\')\n'
              '        .replaceAll(\'ì\', \'i\')\n'
              '        .replaceAll(\'î\', \'i\')\n'
              '        .replaceAll(\'ï\', \'i\')\n'
              '        .replaceAll(\'ó\', \'o\')\n'
              '        .replaceAll(\'ò\', \'o\')\n'
              '        .replaceAll(\'ô\', \'o\')\n'
              '        .replaceAll(\'õ\', \'o\')\n'
              '        .replaceAll(\'ö\', \'o\')\n'
              '        .replaceAll(\'ú\', \'u\')\n'
              '        .replaceAll(\'ù\', \'u\')\n'
              '        .replaceAll(\'û\', \'u\')\n'
              '        .replaceAll(\'ü\', \'u\')\n'
              '        .replaceAll(\'ç\', \'c\')\n'
              '        .replaceAll(\'ñ\', \'n\')\n'
              '        .replaceFirst(RegExp(r\'^[^a-z0-9]+\'), \'\')\n'
              '        .replaceFirst(RegExp(r\'[^a-z0-9]+$\'), \'\')\n'
              '        .replaceAll(RegExp(r\'\\s+\'), \' \')\n'
              '        .trim();\n'
              '\n'
              '    const dependentClinicalFollowUps = <String>{\n'
              '      // Classificacao / categoria / risco — PT\n'
              '      \'classificacao\',\n'
              '      \'a classificacao\',\n'
              '      \'e a classificacao\',\n'
              '      \'qual a classificacao\',\n'
              '      \'qual e a classificacao\',\n'
              '      \'e qual a classificacao\',\n'
              '      \'e qual e a classificacao\',\n'
              '      \'categoria\',\n'
              '      \'a categoria\',\n'
              '      \'e a categoria\',\n'
              '      \'qual a categoria\',\n'
              '      \'qual e a categoria\',\n'
              '      \'e qual a categoria\',\n'
              '      \'e qual e a categoria\',\n'
              '      \'qual o risco\',\n'
              '      \'e qual o risco\',\n'
              '      \'por que corresponde a essa categoria\',\n'
              '      \'por que corresponde a esta categoria\',\n'
              '      \'porque corresponde a essa categoria\',\n'
              '      \'porque corresponde a esta categoria\',\n'
              '      \'por que e essa categoria\',\n'
              '      \'por que essa categoria\',\n'
              '\n'
              '      // Conduta dependente — PT\n'
              '      \'precisa internar\',\n'
              '      \'precisa internacao\',\n'
              '      \'necessita internacao\',\n'
              '      \'requer internacao\',\n'
              '      \'e trombolise\',\n'
              '      \'trombolise\',\n'
              '      \'e reperfusao\',\n'
              '      \'reperfusao\',\n'
              '      \'e a anticoagulacao\',\n'
              '      \'e anticoagulacao\',\n'
              '      \'o que fazer com a anticoagulacao\',\n'
              '      \'e o manejo ambulatorial\',\n'
              '      \'manejo ambulatorial\',\n'
              '      \'pode ter alta\',\n'
              '      \'pode receber alta\',\n'
              '\n'
              '      // Clasificacion / categoria / riesgo — ES\n'
              '      \'clasificacion\',\n'
              '      \'la clasificacion\',\n'
              '      \'y la clasificacion\',\n'
              '      \'cual es la clasificacion\',\n'
              '      \'y cual es la clasificacion\',\n'
              '      \'que clasificacion\',\n'
              '      \'la categoria\',\n'
              '      \'y la categoria\',\n'
              '      \'cual es la categoria\',\n'
              '      \'y cual es la categoria\',\n'
              '      \'que categoria\',\n'
              '      \'que riesgo\',\n'
              '      \'cual es el riesgo\',\n'
              '      \'y cual es el riesgo\',\n'
              '      \'por que corresponde a esa categoria\',\n'
              '      \'porque corresponde a esa categoria\',\n'
              '      \'por que es esa categoria\',\n'
              '      \'por que esa categoria\',\n'
              '\n'
              '      // Conducta dependiente — ES\n'
              '      \'necesita internacion\',\n'
              '      \'requiere internacion\',\n'
              '      \'necesita hospitalizacion\',\n'
              '      \'requiere hospitalizacion\',\n'
              '      \'y trombolisis\',\n'
              '      \'trombolisis\',\n'
              '      \'y reperfusion\',\n'
              '      \'reperfusion\',\n'
              '      \'y que harias con la anticoagulacion\',\n'
              '      \'que harias con la anticoagulacion\',\n'
              '      \'y anticoagulacion\',\n'
              '      \'anticoagulacion\',\n'
              '      \'y manejo ambulatorio\',\n'
              '      \'manejo ambulatorio\',\n'
              '      \'puede darse de alta\',\n'
              '      \'puede tener alta\',\n'
              '\n'
              '      // EN fallback\n'
              '      \'classification\',\n'
              '      \'what is the classification\',\n'
              '      \'what is the category\',\n'
              '      \'why this category\',\n'
              '      \'does this patient need admission\',\n'
              '      \'and thrombolysis\',\n'
              '      \'and anticoagulation\',\n'
              '      \'e o tratamento\',\n'
              '      \'qual o tratamento\',\n'
              '      \'qual e o tratamento\',\n'
              '      \'e a conduta\',\n'
              '      \'qual a conduta\',\n'
              '      \'qual e a conduta\',\n'
              '      \'e o manejo\',\n'
              '      \'qual o manejo\',\n'
              '      \'qual e o manejo\',\n'
              '      \'e os exames\',\n'
              '      \'quais exames\',\n'
              '      \'e o diagnostico\',\n'
              '      \'qual o diagnostico\',\n'
              '      \'e o prognostico\',\n'
              '      \'qual o prognostico\',\n'
              '      \'y el tratamiento\',\n'
              '      \'cual es el tratamiento\',\n'
              '      \'y la conducta\',\n'
              '      \'cual es la conducta\',\n'
              '      \'y el manejo\',\n'
              '      \'cual es el manejo\',\n'
              '      \'y los estudios\',\n'
              '      \'que estudios\',\n'
              '      \'y el diagnostico\',\n'
              '      \'cual es el diagnostico\',\n'
              '      \'y el pronostico\',\n'
              '      \'cual es el pronostico\',\n'
              '      \'and treatment\',\n'
              '      \'what is the treatment\',\n'
              '      \'and management\',\n'
              '      \'what is the management\',\n'
              '    };\n'
              '    final dependentWordCount = dependentClinicalQuery\n'
              '        .split(\' \')\n'
              '        .where((w) => w.isNotEmpty)\n'
              '        .length;\n'
              '\n'
              '    final hasExplicitBackwardReference = RegExp(\n'
              '      r\'\\b(este paciente|ese paciente|esta paciente|\'\n'
              '      r\'neste paciente|nesse paciente|essa categoria|esta categoria|\'\n'
              '      r\'esa categoria|esta categoria|essa classificacao|esta classificacao|\'\n'
              '      r\'esa clasificacion|esta clasificacion|isso|eso|this patient|that category)\\b\',\n'
              '    ).hasMatch(dependentClinicalQuery);\n'
              '\n'
              '    final hasDependentIntent = RegExp(\n'
              '      r\'\\b(classific|clasific|categoria|category|risco|riesgo|risk|\'\n'
              '      r\'intern|hospital|alta|ambulator|trombol|reperfus|anticoag|\'\n'
              '      r\'conduta|conducta|manejo|management|tratamento|tratamiento|treatment)\\w*\',\n'
              '    ).hasMatch(dependentClinicalQuery);\n'
              '\n'
              '    final isDependentClinicalFollowUp =\n'
              '        dependentClinicalFollowUps.contains(dependentClinicalQuery) ||\n'
              '        (dependentWordCount <= 16 &&\n'
              '            hasExplicitBackwardReference &&\n'
              '            hasDependentIntent);\n'
              '\n'
              '    final hasWeight = RegExp(\n'
              '      r\'(^|[^a-z0-9])\\d+(?:[.,]\\d+)?\\s*kg([^a-z0-9]|$)\',\n'
              '    ).hasMatch(qFolded);\n'
              '    final hasCalculationVerb = lexicalTokens.any(\n'
              '      (token) =>\n'
              '          token.startsWith(\'calcul\') &&\n'
              '          token != \'calculadora\' &&\n'
              '          token != \'calculadoras\',\n'
              '    );\n'
              '    final hasCalculationCue =\n'
              '        hasCalculationVerb ||\n'
              '        <String>[\n'
              '          \'dose\',\n'
              '          \'doses\',\n'
              '          \'dosis\',\n'
              '          \'dosagem\',\n'
              '          \'dosificacion\',\n'
              '        ].any(qFolded.contains);\n'
              '    final isWeightCarryForward =\n'
              '        hasWeight &&\n'
              '        (hasCalculationCue ||\n'
              '            qFolded.startsWith(\'e para \') ||\n'
              '            qFolded.startsWith(\'y para \') ||\n'
              '            qFolded.startsWith(\'para \'));\n'
              '\n'
              '    final hasRenalMarker = <String>[\n'
              '      \'creatinina\',\n'
              '      \'clcr\',\n'
              '      \'clearance\',\n'
              '      \'funcao renal\',\n'
              '      \'funcion renal\',\n'
              '      \'depuracao\',\n'
              '      \'depuracion\',\n'
              '    ].any(qFolded.contains);\n'
              '    final hasAdjustmentCue = lexicalTokens.any(\n'
              '      (token) =>\n'
              '          token.startsWith(\'ajust\') ||\n'
              '          token.startsWith(\'adapt\') ||\n'
              '          token.startsWith(\'corrig\') ||\n'
              '          token.startsWith(\'correg\'),\n'
              '    );\n'
              '\n'
              '    final hasVitalOrExamMarker = <String>[\n'
              '      \'pressao arterial\',\n'
              '      \'presion arterial\',\n'
              '      \'spo2\',\n'
              '      \'saturacao\',\n'
              '      \'saturacion\',\n'
              '      \'temperatura\',\n'
              '      \'leucoc\',\n'
              '      \'neutrofil\',\n'
              '      \'plaquet\',\n'
              '      \'hemoglob\',\n'
              '      \'hematoc\',\n'
              '      \'pcr elevada\',\n'
              '      \'crp \',\n'
              '      \'tropon\',\n'
              '      \'lactato\',\n'
              '      \'gasometr\',\n'
              '      \'ureia\',\n'
              '      \'urea\',\n'
              '      \'sodio\',\n'
              '      \'potassio\',\n'
              '      \'potasio\',\n'
              '      \'ecg\',\n'
              '      \'eletrocard\',\n'
              '      \'electrocard\',\n'
              '      \'usg\',\n'
              '      \'ultrass\',\n'
              '      \'ecograf\',\n'
              '      \'tomografia\',\n'
              '      \'ressonancia\',\n'
              '      \'resonancia\',\n'
              '      \'raio x\',\n'
              '      \'rayos x\',\n'
              '      \'imagem\',\n'
              '      \'imagen\',\n'
              '      \'inconclus\',\n'
              '    ].any(qFolded.contains);\n'
              '\n'
              '    final hasObjectiveNumber = RegExp(\n'
              '      r\'\\b\\d+(?:[.,]\\d+)?\\s*(?:c|mmhg|bpm|x10|mil|mg/dl|mmol|meq|%)\\b\',\n'
              '    ).hasMatch(qFolded);\n'
              '\n'
              '    return isDependentClinicalFollowUp ||\n'
              '        isWeightCarryForward ||\n'
              '        (hasRenalMarker && hasAdjustmentCue) ||\n'
              '        _isRichClinicalNarrativeFollowUp(qFolded) ||\n'
              '        hasVitalOrExamMarker ||\n'
              '        hasObjectiveNumber;\n'
              '  }\n'
              '\n'
              '  static bool _isRichClinicalNarrativeFollowUp(String foldedText) {\n'
              '    final markers = <RegExp>[\n'
              '      RegExp(r\'\\b(?:comecou|iniciou|inicio|desde)\\b\'),\n'
              '      RegExp(r\'\\bha\\s+\\d+(?:[.,]\\d+)?\\s*(?:h|hora|horas|dia|dias)\\b\'),\n'
              '      RegExp(r\'\\b(?:migrou|irradiou|piorou|melhorou|evoluiu)\\b\'),\n'
              '      RegExp(r\'\\b(?:refere|relata|nega|presenta)\\b\'),\n'
              '      RegExp(r\'\\b(?:sem|sin)\\s+sintomas?\\b\'),\n'
              '      RegExp(r\'\\b(?:febre|fiebre|nausea|nauseas|vomito|vomitos)\\b\'),\n'
              '    ];\n'
              '\n'
              '    var hits = 0;\n'
              '    for (final marker in markers) {\n'
              '      if (marker.hasMatch(foldedText)) hits++;\n'
              '      if (hits >= 2) return true;\n'
              '    }\n'
              '    return false;\n'
              '  }\n'
              '\n'
              '  // ── Keywords de novo caso — qualquer uma dessas em query longa → new thread ─\n'
              '  // Sintomas sistêmicos sem relação farmacológica = novo caso clínico.\n'
              '  //\n'
              '  // BUILD 305 [C2]: Tokens frágeis com espaçamento manual (\'iam \', \' iam\',\n'
              '  // \'tep \', \' tep\', \'avc \', \' avc\') REMOVIDOS.\n'
              '  // PROBLEMA: pontuação grudada ("IAM, conduta" → "iam , conduta" após\n'
              '  // lowercase) não casava com \'iam \' (espaço após vírgula truncado).\n'
              '  // SOLUÇÃO: tokens limpos sem padding. A query é normalizada antes de .any()\n'
              '  // via q.contains(s) — o split de pontuação em evaluate() já usa\n'
              '  // replaceAll(RegExp(r\'[^\\w\\s]\'), \' \'), logo \'iam\' casa corretamente.\n'
              '  // Cobertura completa mantida via _kIsolatedNewCaseTerms (Set exato).\n'
              '\n'
              '  // PLANTAO_GLOBAL_CONTEXT_SEMANTIC_SWITCH_V1\n'
              '  //\n'
              '  // Canonicaliza aliases clinicos apenas para decidir continuidade do thread.\n'
              '  // A pergunta visivel e o texto enviado ao modelo permanecem inalterados.\n'
              '  static String _canonicalizePlantaoTopicAliases(String input) {\n'
              '    var q = input\n'
              '        .toLowerCase()\n'
              '        .replaceAll(\'á\', \'a\')\n'
              '        .replaceAll(\'à\', \'a\')\n'
              '        .replaceAll(\'â\', \'a\')\n'
              '        .replaceAll(\'ã\', \'a\')\n'
              '        .replaceAll(\'ä\', \'a\')\n'
              '        .replaceAll(\'é\', \'e\')\n'
              '        .replaceAll(\'è\', \'e\')\n'
              '        .replaceAll(\'ê\', \'e\')\n'
              '        .replaceAll(\'ë\', \'e\')\n'
              '        .replaceAll(\'í\', \'i\')\n'
              '        .replaceAll(\'ì\', \'i\')\n'
              '        .replaceAll(\'î\', \'i\')\n'
              '        .replaceAll(\'ï\', \'i\')\n'
              '        .replaceAll(\'ó\', \'o\')\n'
              '        .replaceAll(\'ò\', \'o\')\n'
              '        .replaceAll(\'ô\', \'o\')\n'
              '        .replaceAll(\'õ\', \'o\')\n'
              '        .replaceAll(\'ö\', \'o\')\n'
              '        .replaceAll(\'ú\', \'u\')\n'
              '        .replaceAll(\'ù\', \'u\')\n'
              '        .replaceAll(\'û\', \'u\')\n'
              '        .replaceAll(\'ü\', \'u\')\n'
              '        .replaceAll(\'ç\', \'c\')\n'
              '        .replaceAll(\'ñ\', \'n\')\n'
              '        .replaceAll(\'_\', \' \');\n'
              '\n'
              '    q = q\n'
              '        .replaceAll(\n'
              '          RegExp(r\'\\b(?:dbt|dm1|dm2|t1dm|t2dm)\\b\'),\n'
              '          \' diabetes \',\n'
              '        )\n'
              '        .replaceAll(RegExp(r\'\\bdiabetes\\s+mellitus\\b\'), \' diabetes \')\n'
              '        .replaceAll(\n'
              '          RegExp(\n'
              '            r\'\\b(?:iam|iamcest|iamcsst|iamssst|iamsest|stemi|nstemi)\\b\',\n'
              '          ),\n'
              '          \' infarto miocardio \',\n'
              '        )\n'
              '        .replaceAll(RegExp(r\'\\btep\\b\'), \' tromboembolismo pulmonar \')\n'
              '        .replaceAll(RegExp(r\'\\b(?:dpoc|copd)\\b\'), \' epoc \')\n'
              '        .replaceAll(RegExp(r\'\\s+\'), \' \')\n'
              '        .trim();\n'
              '\n'
              '    return q;\n'
              '  }\n'
              '\n'
              'static const _kNewCaseSignals = <String>[\n'
              '    // Sintomas gastrointestinais / gerais\n'
              '    \'náusea\', \'nausea\', \'vômito\', \'vomito\', \'diarreia\', \'diarrea\',\n'
              '    \'dor abdominal\', \'abdome\', \'abdomen\', \'dor de barriga\',\n'
              '    \'febre\', \'fiebre\', \'calafrio\', \'escalofrio\',\n'
              '    \'dispneia\', \'disnea\', \'falta de ar\', \'falta de aire\',\n'
              '    \'dor no peito\', \'dolor de pecho\', \'dor precordial\',\n'
              '    \'cefaleia\', \'cefalea\', \'dor de cabeça\', \'dolor de cabeza\',\n'
              '    \'tontura\', \'mareo\', \'vertigem\', \'vértigo\',\n'
              '    \'fraqueza\', \'debilidad\', \'cansaço\',\n'
              '    \'tosse\', \'tos\', \'expectoração\',\n'
              '    \'sangramento\', \'sangramiento\', \'hemorragia\',\n'
              '    \'perda de consciência\', \'pérdida de conciencia\',\n'
              '    \'confusão\', \'confusion\', \'desorientação\',\n'
              '    \'edema\', \'inchaço\', \'hinchazón\',\n'
              '    // Padrões de novo caso ("paciente com", "paciente de")\n'
              '    \'paciente com\', \'paciente de\', \'paciente apresenta\',\n'
              '    \'paciente con\', \'paciente presenta\',\n'
              '    \'homem de\', \'mulher de\', \'hombre de\', \'mujer de\',\n'
              '    \'anos com\', \'años con\', \'anos de\', \'años de\',\n'
              '    // Diagnósticos completamente diferentes\n'
              '    // BUILD 305 [C2]: tokens limpos — sem padding de espaço (\'iam \', \' iam\',\n'
              '    // \'tep \', \' tep\', \'avc \', \' avc\' removidos; cobertura mantida pelos\n'
              '    // termos base + _kIsolatedNewCaseTerms que faz match exato por palavra).\n'
              '    \'gastroenterite\', \'gastroenteritis\', \'gastrenterite\',\n'
              '    \'pneumonia\', \'meningite\', \'meningitis\',\n'
              '    \'infarto\', \'iam\', \'tep\', \'avc\', \'acidente vascular\',\n'
              '    \'sepse\', \'sepsis\', \'choque\',\n'
              '    \'anafilaxia\', \'anafilaxis\',\n'
              '    \'intoxicação\', \'intoxicacion\',\n'
              '\n'
              '    \'dbt\',\n'
              '    \'dm1\',\n'
              '    \'dm2\',\n'
              '    \'t1dm\',\n'
              '    \'t2dm\',\n'
              '    \'diabetes\',];\n'
              '\n'
              '  // ── ORDEM 33 — MANDATO 2: Termos clínicos isolados que SEMPRE iniciam novo thread ─\n'
              '  //\n'
              '  // DIAGNÓSTICO DO BUG "HISTÓRICO FANTASMA":\n'
              '  //   Quando o médico digita "ICC" (1 palavra, 3 chars):\n'
              '  //     wordCount=1 ≤ 3 → isTooShort=true → continueThread → history da Sertralina\n'
              '  //     vaza para o novo contexto de ICC → resposta mista / contaminação cruzada.\n'
              '  //\n'
              '  // SOLUÇÃO — PRE-CHECK DE ISOLAMENTO:\n'
              '  //   Antes de aplicar a regra isTooShort, verificar se a query é um termo\n'
              '  //   clínico ISOLADO de nova patologia (acrônimo ou nome de doença sem qualquer\n'
              '  //   palavra de follow-up). Se sim → newThread MESMO sendo curta.\n'
              '  //   Critério: query normalizada (sem pontuação) é exatamente um desses termos.\n'
              '  //\n'
              '  // COBERTURA: acrônimos PT-BR + ES + nomes por extensão comuns em Plantão.\n'
              '  static const _kIsolatedNewCaseTerms = <String>{\n'
              '    // Cardiovascular\n'
              '    \'icc\', \'icc.\', \'iam\', \'iam.\', \'sca\', \'sca.\',\n'
              '    \'fa\', \'fa.\', \'flutter\', \'tep\', \'tep.\',\n'
              '    \'tvp\', \'tvp.\',\n'
              '    \'dissecção\', \'diseccion\',\n'
              '    \'tam\', \'bloqueio\', \'bradicardia\', \'taquicardia\', \'fibrilação\',\n'
              '    \'fibrilacion\', \'cardioversão\',\n'
              '    // Neurológico\n'
              '    \'avc\', \'avc.\', \'acv\', \'acv.\', \'ave\', \'tia\', \'tia.\',\n'
              '    \'meningite\', \'meningitis\', \'encefalite\', \'encefalitis\',\n'
              '    \'crise\', \'convulsão\', \'convulsion\', \'epilepsia\',\n'
              '    // Respiratório\n'
              '    \'dpoc\', \'dpoc.\', \'epoc\', \'asma\', \'asthma\', \'beca\',\n'
              '    \'ards\', \'srag\', \'pcp\',\n'
              '    \'pneumotórax\', \'pneumotorax\', \'derrame\', \'efusão\',\n'
              '    // Renal / metabólico\n'
              '    \'ira\', \'ira.\', \'lra\', \'lra.\', \'irc\', \'drc\',\n'
              '    \'cad\', \'cad.\', \'hhns\', \'hhs\',\n'
              '    \'hipoglicemia\', \'hiperglicemia\',\n'
              '    \'hiponatremia\', \'hipernatremia\',\n'
              '    \'hipocalemia\', \'hipercalemia\', \'hipercalcemia\',\n'
              '    // Infecção / imunológico\n'
              '    \'sepse\', \'sepsis\', \'sirs\', \'choque\', \'shock\',\n'
              '    \'anafilaxia\', \'anafilaxis\',\n'
              '    \'endocardite\', \'endocarditis\',\n'
              '    // Trauma / emergência\n'
              '    \'politrauma\', \'tcce\', \'tce\', \'queimadura\', \'quemadura\',\n'
              '    \'afogamento\', \'ahogamiento\',\n'
              '    \'hemorragia\', \'hemotórax\', \'hemotorax\',\n'
              '    // Digestivo / hepático\n'
              '    \'cirrosis\', \'cirrose\',\n'
              '    \'psa\', \'psa.\', // pancreatite aguda severa\n'
              '    \'hemorragia digestiva\', \'hdab\', \'hdai\',\n'
              '    // Obstétrico\n'
              '    \'eclampsia\', \'preeclampsia\',\n'
              '    \'hellp\',\n'
              '  };\n'
              '\n'
              '  // Sinais demográficos são úteis para detectar um caso novo em perguntas\n'
              '  // completas, mas não devem apagar o thread quando aparecem dentro de um pedido\n'
              '  // contextual como "calcule para um paciente de 18 kg".\n'
              '  static const _kDemographicNewCaseSignals = <String>{\n'
              '    \'paciente com\',\n'
              '    \'paciente de\',\n'
              '    \'paciente apresenta\',\n'
              '    \'paciente con\',\n'
              '    \'paciente presenta\',\n'
              '    \'homem de\',\n'
              '    \'mulher de\',\n'
              '    \'hombre de\',\n'
              '    \'mujer de\',\n'
              '    \'anos com\',\n'
              '    \'años con\',\n'
              '    \'anos de\',\n'
              '    \'años de\',\n'
              '  };\n'
              '\n'
              '  // ── Fármacos de alta especificidade (detectar mudança de fármaco-alvo) ─────\n'
              '  static const _kHighSpecificityDrugs = <String>[\n'
              '    \'amiodarona\',\n'
              '    \'amiodarone\',\n'
              '    \'vancomicina\',\n'
              '    \'vancomycin\',\n'
              '    \'noradrenalina\',\n'
              '    \'norepinefrina\',\n'
              '    \'heparina\',\n'
              '    \'heparin\',\n'
              '    \'insulina\',\n'
              '    \'insulin\',\n'
              '    \'warfarina\',\n'
              '    \'varfarina\',\n'
              '    \'metformina\',\n'
              '    \'metformin\',\n'
              '    \'prednisona\',\n'
              '    \'prednisolona\',\n'
              '    \'furosemida\',\n'
              '    \'furosemide\',\n'
              '    \'metoprolol\',\n'
              '    \'propranolol\',\n'
              '    \'enalapril\',\n'
              '    \'captopril\',\n'
              '    \'losartana\',\n'
              '    \'ceftriaxona\',\n'
              '    \'meropenem\',\n'
              '    \'piperacilina\',\n'
              '    \'midazolam\',\n'
              '    \'propofol\',\n'
              '    \'fentanil\',\n'
              '    \'ketamina\',\n'
              '    \'etomidato\',\n'
              '    \'succinilcolina\',\n'
              '    \'rocurônio\',\n'
              '    \'adrenalina\',\n'
              '    \'epinefrina\',\n'
              '    \'dopamina\',\n'
              '    \'dobutamina\',\n'
              '    \'nitroprussiato\',\n'
              '    \'nitroglicerina\',\n'
              '  ];\n'
              '\n'
              '  // ─────────────────────────────────────────────────────────────────────────\n'
              '  // evaluate() — avalia a nova query e retorna ClinicalThreadStatus\n'
              '  //\n'
              '  // Chamado em sendAiMessage() e buildAIAnswer() ANTES de montar o histórico.\n'
              '  // ─────────────────────────────────────────────────────────────────────────\n'
              '  ClinicalThreadStatus evaluate({\n'
              '    required String currentUserText,\n'
              '    required bool isPlantaoMode,\n'
              '    bool cameFromButton = false,\n'
              '  }) {\n'
              '    final now = DateTime.now().millisecondsSinceEpoch;\n'
              '    final q = currentUserText.trim().toLowerCase();\n'
              '    final wordCount = q.split(RegExp(r\'\\s+\')).where((w) => w.isNotEmpty).length;\n'
              '\n'
              '    // ── Timeout de inatividade → novo thread ───────────────────────────────\n'
              '    if (isPlantaoMode &&\n'
              '        _activeTopic.isNotEmpty &&\n'
              '        _lastActivityMs > 0 &&\n'
              '        (now - _lastActivityMs) > kThreadTimeoutMs) {\n'
              '      final oldTopic = _activeTopic;\n'
              '      _startNewThread(q, now);\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.newThread,\n'
              '        reason: \'inactivity_timeout\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // ── Thread vazio → inicia ──────────────────────────────────────────────\n'
              '    if (_activeTopic.isEmpty) {\n'
              '      _startNewThread(q, now);\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.newThread,\n'
              '        reason: \'first_message\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // ── Veio de botão clínico → sempre continuation ───────────────────────\n'
              '    if (cameFromButton) {\n'
              '      _turnCount++;\n'
              '      _lastActivityMs = now;\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[THREAD_MANAGER] mode=${isPlantaoMode ? "plantao" : "estudo"} \'\n'
              '          \'action=continue_thread reason=button_action \'\n'
              '          \'topic=$_activeTopic turnCount=$_turnCount\',\n'
              '        );\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.continueThread,\n'
              '        reason: \'button_action\',\n'
              '        topic: _activeTopic,\n'
              '        fromButton: true,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // ── ORDEM 33 — MANDATO 2: Termo clínico isolado de nova patologia ────────\n'
              '    // PRE-CHECK síncrono antes de qualquer regra de follow-up.\n'
              '    //\n'
              '    // BUG ALVO: "ICC" → wordCount=1 ≤ 3 → isTooShort=true → continueThread →\n'
              '    // history da Sertralina vaza para contexto de ICC → resposta mista.\n'
              '    //\n'
              '    // LÓGICA: se a query normalizada (trim + lowercase + sem pontuação) for\n'
              '    // EXATAMENTE um dos termos em _kIsolatedNewCaseTerms, ela é uma nova patologia\n'
              '    // isolada — independente de ser curta — e DEVE iniciar novo thread.\n'
              '    // Isso toma precedência sobre isTooShort e followUpPhrase.\n'
              '    //\n'
              '    // Também detecta termos de 1-2 palavras com fármaco diferente do ativo\n'
              '    // (ex: "Sertralina" quando thread ativo era "ICC").\n'
              '    final qNorm = q.replaceAll(RegExp(r\'[^\\w\\s]\'), \'\').trim();\n'
              '    final isIsolatedNewCase = _kIsolatedNewCaseTerms.contains(qNorm);\n'
              '\n'
              '    // Também detecta: query curta que contém OUTRO fármaco de alta especificidade\n'
              '    // diferente do fármaco ativo no thread (ex: thread=sertralina, query="ICC").\n'
              '    // Não se aplica: nenhum fármaco detectado → só isIsolatedNewCase decide.\n'
              '    final shortQueryDrugSwitch = (() {\n'
              '      if (!isPlantaoMode) return false;\n'
              '      final currentDrugShort = _detectPrimaryDrug(qNorm);\n'
              '      final activeDrugShort = _detectPrimaryDrug(_activeTopic.toLowerCase());\n'
              '      // Fármaco diferente do ativo → switch, mesmo query curta\n'
              '      return currentDrugShort != null &&\n'
              '          activeDrugShort != null &&\n'
              '          currentDrugShort != activeDrugShort;\n'
              '    })();\n'
              '\n'
              '    // R20 — repetir a MESMA patologia isolada no Modo Estudo não muda de tema.\n'
              '    // Corrige a sequência física: "Explicarme asma" -> "asma".\n'
              '    final incomingStudyTopic = !isPlantaoMode ? _extractTopicSignature(q) : \'\';\n'
              '    final sameStudyIsolatedTopic =\n'
              '        !isPlantaoMode &&\n'
              '        isIsolatedNewCase &&\n'
              '        incomingStudyTopic.isNotEmpty &&\n'
              '        incomingStudyTopic == _activeTopic;\n'
              '\n'
              '    if (sameStudyIsolatedTopic) {\n'
              '      _turnCount++;\n'
              '      _lastActivityMs = now;\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[R20][THREAD_MANAGER] mode=estudo \'\n'
              '          \'action=continue_thread reason=study_same_topic_isolated_term \'\n'
              '          \'topic=$_activeTopic turnCount=$_turnCount\',\n'
              '        );\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.continueThread,\n'
              '        reason: \'study_same_topic_isolated_term\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    if (isIsolatedNewCase || shortQueryDrugSwitch) {\n'
              '      final oldTopic = _activeTopic;\n'
              '      _startNewThread(q, now);\n'
              '      debugPrint(\n'
              '        \'[THREAD_MANAGER] mode=${isPlantaoMode ? "plantao" : "estudo"} \'\n'
              '        \'action=new_thread \'\n'
              '        \'reason=${isIsolatedNewCase ? "isolated_new_case_term" : "short_drug_switch"} \'\n'
              '        \'oldTopic=$oldTopic newTopic=$_activeTopic \'\n'
              '        \'query="$q"\',\n'
              '      );\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.newThread,\n'
              '        reason: isIsolatedNewCase\n'
              '            ? \'isolated_new_case_term\'\n'
              '            : \'short_drug_switch\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // ── Query muito curta / follow-up phrase → continuation ───────────────\n'
              '    final isFollowUpPhrase = _kFollowUpPhrases.any(\n'
              '      (p) => q == p || q.startsWith(\'$p \') || q.endsWith(\' $p\'),\n'
              '    );\n'
              '    final isTooShort = wordCount <= 3;\n'
              '    final shortContextualFollowUp = isContextualClinicalFollowUp(\n'
              '      currentUserText,\n'
              '    );\n'
              '    final shortFolded = q\n'
              '        .replaceAll(\'á\', \'a\')\n'
              '        .replaceAll(\'é\', \'e\')\n'
              '        .replaceAll(\'í\', \'i\')\n'
              '        .replaceAll(\'ó\', \'o\')\n'
              '        .replaceAll(\'ú\', \'u\')\n'
              '        .replaceAll(\'ü\', \'u\')\n'
              '        .replaceAll(\'ç\', \'c\');\n'
              '    final shortTokens = RegExp(\n'
              '      r\'[a-z0-9]+\',\n'
              '    ).allMatches(shortFolded).map((match) => match.group(0)!).toSet();\n'
              '    final shortStrongCardiacAlias = const <String>{\n'
              '      \'iamcsst\',\n'
              '      \'iamcest\',\n'
              '      \'iamssst\',\n'
              '      \'iamsest\',\n'
              '      \'stemi\',\n'
              '      \'nstemi\',\n'
              '    }.any(shortTokens.contains);\n'
              '    final shortThreadStartFolded = _threadStartQuery\n'
              '        .toLowerCase()\n'
              '        .replaceAll(\'á\', \'a\')\n'
              '        .replaceAll(\'é\', \'e\')\n'
              '        .replaceAll(\'í\', \'i\')\n'
              '        .replaceAll(\'ó\', \'o\')\n'
              '        .replaceAll(\'ú\', \'u\')\n'
              '        .replaceAll(\'ü\', \'u\')\n'
              '        .replaceAll(\'ç\', \'c\');\n'
              '    final shortCardiacCompatible =\n'
              '        shortStrongCardiacAlias &&\n'
              '        <String>[\n'
              '          \'torac\',\n'
              '          \'peito\',\n'
              '          \'precord\',\n'
              '          \'angin\',\n'
              '          \'coronar\',\n'
              '          \'cardiac\',\n'
              '          \'iam\',\n'
              '          \'sca\',\n'
              '        ].any(shortThreadStartFolded.contains);\n'
              '    final shortQueryClinicalSwitch =\n'
              '        isPlantaoMode &&\n'
              '        isTooShort &&\n'
              '        !isFollowUpPhrase &&\n'
              '        !shortContextualFollowUp &&\n'
              '        (shortStrongCardiacAlias ||\n'
              '            _kNewCaseSignals.any((signal) {\n'
              '              final foldedSignal = signal\n'
              '                  .replaceAll(\'á\', \'a\')\n'
              '                  .replaceAll(\'é\', \'e\')\n'
              '                  .replaceAll(\'í\', \'i\')\n'
              '                  .replaceAll(\'ó\', \'o\')\n'
              '                  .replaceAll(\'ú\', \'u\')\n'
              '                  .replaceAll(\'ü\', \'u\')\n'
              '                  .replaceAll(\'ç\', \'c\');\n'
              '              if (foldedSignal.contains(\' \')) {\n'
              '                return shortFolded.contains(foldedSignal);\n'
              '              }\n'
              '              return shortTokens.contains(foldedSignal);\n'
              '            })) &&\n'
              '        !_topicsOverlap(_activeTopic, q) &&\n'
              '        !shortCardiacCompatible;\n'
              '\n'
              '    if (shortQueryClinicalSwitch) {\n'
              '      final oldTopic = _activeTopic;\n'
              '      _startNewThread(q, now);\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[THREAD_MANAGER] mode=plantao \'\n'
              '          \'action=new_thread reason=short_clinical_switch \'\n'
              '          \'oldTopic=$oldTopic newTopic=$_activeTopic\',\n'
              '        );\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.newThread,\n'
              '        reason: \'short_clinical_switch\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    if (isTooShort || isFollowUpPhrase) {\n'
              '      _turnCount++;\n'
              '      _lastActivityMs = now;\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[THREAD_MANAGER] mode=${isPlantaoMode ? "plantao" : "estudo"} \'\n'
              '          \'action=continue_thread reason=${isFollowUpPhrase ? "followup_phrase" : "short_query"} \'\n'
              '          \'topic=$_activeTopic turnCount=$_turnCount\',\n'
              '        );\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.continueThread,\n'
              '        reason: isFollowUpPhrase ? \'followup_phrase\' : \'short_query\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // ── BUILD 300: MODO ESTUDO — memória 100% linear, sem HARD RESET por tópico ──\n'
              '    // No Modo Estudo (!isPlantaoMode) o estudo clínico expande e ramifica\n'
              '    // naturalmente. "Asma → broncodilatador → efeitos adversos" é continuação\n'
              '    // legítima mesmo sem overlap de palavras-chave. Nunca aplicar newThread por\n'
              '    // no_topic_overlap / new_case_signal / drug_switch no Modo Estudo.\n'
              '    // first_message e inactivity_timeout permanecem ativos em ambos os modos.\n'
              '    if (!isPlantaoMode) {\n'
              '      _turnCount++;\n'
              '      _lastActivityMs = now;\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[BUILD300][THREAD_MANAGER] mode=estudo \'\n'
              '          \'action=continue_thread reason=study_mode_memory_preserved \'\n'
              '          \'topic=$_activeTopic turnCount=$_turnCount\',\n'
              '        );\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.continueThread,\n'
              '        reason: \'study_mode_memory_preserved\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // ── Detecta mudança forte de tópico (APENAS Modo Plantão) ─────────────\n'
              '    // BUILD 305 [C2]: matching seguro por palavra inteira para tokens curtos.\n'
              '    // q já foi normalizado (lowercase, trim). Tokens com espaço (multi-palavra)\n'
              '    // usam contains direto. Tokens sem espaço ≤ 4 chars usam RegExp \\b para\n'
              '    // evitar falso positivo: \'iam\' em "vitamina", \'avc\' em "travca", etc.\n'
              '    // Tokens > 4 chars: contains é seguro (colisão léxica negligenciável).\n'
              '    final qNormSig = \' $q \'; // padding para word-boundary simplificado\n'
              '    bool matchesNewCaseSignal(String signal) {\n'
              '      if (signal == \'iam\' &&\n'
              '          RegExp(\n'
              '            r\'(^|[^a-z0-9])(?:iamcsst|iamcest|iamssst|iamsest|stemi|nstemi)([^a-z0-9]|$)\',\n'
              '          ).hasMatch(q)) {\n'
              '        return true;\n'
              '      }\n'
              '      if (signal.contains(\' \')) return q.contains(signal);\n'
              '      if (signal.length <= 4) return qNormSig.contains(\' $signal \');\n'
              '      return q.contains(signal);\n'
              '    }\n'
              '\n'
              '    final hasNewCaseSignal = _kNewCaseSignals.any(matchesNewCaseSignal);\n'
              '    final hasStrongNewCaseSignal = _kNewCaseSignals.any(\n'
              '      (signal) =>\n'
              '          !_kDemographicNewCaseSignals.contains(signal) &&\n'
              '          matchesNewCaseSignal(signal),\n'
              '    );\n'
              '\n'
              '    // Detecta fármaco novo diferente do thread ativo\n'
              '    final currentDrug = _detectPrimaryDrug(q);\n'
              '    final activeDrug = _detectPrimaryDrug(_activeTopic.toLowerCase());\n'
              '    final hasDrugSwitch =\n'
              '        currentDrug != null && activeDrug != null && currentDrug != activeDrug;\n'
              '\n'
              '    // Verifica overlap temático com o thread ativo\n'
              '    final topicOverlap = _topicsOverlap(_activeTopic, q);\n'
              '    final isContextualFollowUp = isContextualClinicalFollowUp(currentUserText);\n'
              '    final foldedCurrent = q\n'
              '        .replaceAll(\'á\', \'a\')\n'
              '        .replaceAll(\'é\', \'e\')\n'
              '        .replaceAll(\'í\', \'i\')\n'
              '        .replaceAll(\'ó\', \'o\')\n'
              '        .replaceAll(\'ú\', \'u\')\n'
              '        .replaceAll(\'ü\', \'u\')\n'
              '        .replaceAll(\'ç\', \'c\');\n'
              '    final richNarrativeFollowUp = _isRichClinicalNarrativeFollowUp(\n'
              '      foldedCurrent,\n'
              '    );\n'
              '    final hasAcuteCoronaryAlias = RegExp(\n'
              '      r\'(^|[^a-z0-9])(?:iamcsst|iamcest|iamssst|iamsest|stemi|nstemi)([^a-z0-9]|$)\',\n'
              '    ).hasMatch(foldedCurrent);\n'
              '    final threadStartFolded = _threadStartQuery\n'
              '        .toLowerCase()\n'
              '        .replaceAll(\'á\', \'a\')\n'
              '        .replaceAll(\'é\', \'e\')\n'
              '        .replaceAll(\'í\', \'i\')\n'
              '        .replaceAll(\'ó\', \'o\')\n'
              '        .replaceAll(\'ú\', \'u\')\n'
              '        .replaceAll(\'ü\', \'u\')\n'
              '        .replaceAll(\'ç\', \'c\');\n'
              '    final compatibleAcuteCoronaryProgression =\n'
              '        hasAcuteCoronaryAlias &&\n'
              '        <String>[\n'
              '          \'torac\',\n'
              '          \'peito\',\n'
              '          \'precord\',\n'
              '          \'angin\',\n'
              '          \'coronar\',\n'
              '          \'cardiac\',\n'
              '          \'iam\',\n'
              '          \'sca\',\n'
              '        ].any(threadStartFolded.contains);\n'
              '\n'
              '    // PLANTAO_EXPLICIT_CASE_BOUNDARY_PRECEDENCE_V1\n'
              '    //\n'
              '    // Fronteiras explícitas de caso/paciente são absolutas e precisam ser\n'
              '    // avaliadas antes de qualquer continuação por progressão diagnóstica\n'
              '    // compatível (ex.: IAMCEST -> IAMCEST em outro paciente).\n'
              '    final explicitCaseBoundaryEarly = <String>[\n'
              '      \'novo caso\',\n'
              '      \'nova paciente\',\n'
              '      \'novo paciente\',\n'
              '      \'outro paciente\',\n'
              '      \'outra paciente\',\n'
              '      \'mudar de caso\',\n'
              '      \'trocar de caso\',\n'
              '      \'nuevo caso\',\n'
              '      \'nuevo paciente\',\n'
              '      \'nueva paciente\',\n'
              '      \'otro paciente\',\n'
              '      \'otra paciente\',\n'
              '      \'cambiar de caso\',\n'
              '      \'new case\',\n'
              '      \'new patient\',\n'
              '      \'another patient\',\n'
              '    ].any(q.contains);\n'
              '\n'
              '    if (explicitCaseBoundaryEarly) {\n'
              '      final oldTopic = _activeTopic;\n'
              '      _startNewThread(q, now);\n'
              '\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\'[THREAD_MANAGER] mode=plantao \'\n'
              '            \'action=new_thread \'\n'
              '            \'reason=new_case_signal \'\n'
              '            \'oldTopic=$oldTopic newTopic=$_activeTopic\');\n'
              '      }\n'
              '\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.newThread,\n'
              '        reason: \'new_case_signal\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // Uma confirmação de IAM/STEMI pode ser a progressão natural de uma queixa\n'
              '    // torácica já ativa. Nesse caso preservamos o contexto; em qualquer tópico\n'
              '    // incompatível (por exemplo, fossa ilíaca) o alias forte continua abaixo\n'
              '    // para a regra canônica de newThread.\n'
              '    if (isPlantaoMode && compatibleAcuteCoronaryProgression && !hasDrugSwitch) {\n'
              '      _turnCount++;\n'
              '      _lastActivityMs = now;\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[THREAD_MANAGER] mode=plantao \'\n'
              '          \'action=continue_thread reason=compatible_diagnostic_progression \'\n'
              '          \'topic=$_activeTopic turnCount=$_turnCount\',\n'
              '        );\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.continueThread,\n'
              '        reason: \'compatible_diagnostic_progression\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // Resultados objetivos não precisam repetir o tópico. Narrativa clínica só\n'
              '    // vence um sinal sintomático de novo caso quando contém múltiplos marcadores\n'
              '    // de evolução/associação; isso evita transformar uma nova queixa isolada em\n'
              '    // continuação por acidente.\n'
              '    if (isContextualFollowUp &&\n'
              '        !hasDrugSwitch &&\n'
              '        (!hasStrongNewCaseSignal || topicOverlap || richNarrativeFollowUp)) {\n'
              '      _turnCount++;\n'
              '      _lastActivityMs = now;\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[THREAD_MANAGER] mode=plantao \'\n'
              '          \'action=continue_thread reason=contextual_clinical_followup \'\n'
              '          \'topic=$_activeTopic turnCount=$_turnCount\',\n'
              '        );\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.continueThread,\n'
              '        reason: \'contextual_clinical_followup\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // PLANTAO_GLOBAL_SAME_TOPIC_SIGNAL_PRECEDENCE_V1\n'
              '    //\n'
              '    // Mencionar uma patologia/alias conhecido nao significa automaticamente\n'
              '    // "novo caso". O overlap semantico do tema ativo vence o sinal generico.\n'
              '    // Fronteiras explicitas de caso/paciente continuam absolutas.\n'
              '    final explicitCaseBoundary = <String>[\n'
              '      \'novo caso\',\n'
              '      \'nova paciente\',\n'
              '      \'novo paciente\',\n'
              '      \'outro paciente\',\n'
              '      \'outra paciente\',\n'
              '      \'mudar de caso\',\n'
              '      \'trocar de caso\',\n'
              '      \'nuevo caso\',\n'
              '      \'nuevo paciente\',\n'
              '      \'nueva paciente\',\n'
              '      \'otro paciente\',\n'
              '      \'otra paciente\',\n'
              '      \'cambiar de caso\',\n'
              '      \'new case\',\n'
              '      \'new patient\',\n'
              '      \'another patient\',\n'
              '    ].any(q.contains);\n'
              '\n'
              '    final shouldStartNewThread =\n'
              '        explicitCaseBoundary || hasDrugSwitch || !topicOverlap;\n'
              '\n'
              '    if (shouldStartNewThread) {\n'
              '      final oldTopic = _activeTopic;\n'
              '      _startNewThread(q, now);\n'
              '\n'
              '      final newThreadReason = explicitCaseBoundary ||\n'
              '              (hasNewCaseSignal && !topicOverlap)\n'
              '          ? \'new_case_signal\'\n'
              '          : (hasDrugSwitch ? \'drug_switch\' : \'no_topic_overlap\');\n'
              '\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\'[THREAD_MANAGER] mode=plantao \'\n'
              '            \'action=new_thread \'\n'
              '            \'reason=$newThreadReason \'\n'
              '            \'oldTopic=$oldTopic newTopic=$_activeTopic\');\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.newThread,\n'
              '        reason: newThreadReason,\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // ── Mesmo tópico → continuation ───────────────────────────────────────\n'
              '    _turnCount++;\n'
              '    _lastActivityMs = now;\n'
              '    if (kDebugMode) {\n'
              '      debugPrint(\n'
              '        \'[THREAD_MANAGER] mode=${isPlantaoMode ? "plantao" : "estudo"} \'\n'
              '        \'action=continue_thread reason=same_topic \'\n'
              '        \'topic=$_activeTopic turnCount=$_turnCount\',\n'
              '      );\n'
              '    }\n'
              '    return ClinicalThreadStatus(\n'
              '      action: ThreadAction.continueThread,\n'
              '      reason: \'same_topic\',\n'
              '      topic: _activeTopic,\n'
              '    );\n'
              '  }\n'
              '\n'
              '  // ─────────────────────────────────────────────────────────────────────────\n'
              '  // buildThreadHistory() — constrói lista de histórico para enviar ao Gemini\n'
              '  //\n'
              '  // isContinuation=true  → últimas kMaxContinuationTurns pares (máx 6 entradas)\n'
              '  // isContinuation=false → lista vazia (contexto limpo)\n'
              '  // ─────────────────────────────────────────────────────────────────────────\n'
              '\n'
              '  // BUILD 307 [AMNESIA_COOLDOWN]: fármaco-alvo primário da última mensagem.\n'
              '  // Preserva histórico de transporte quando o médico muda de intent mas\n'
              '  // mantém o mesmo fármaco-alvo (ex: "dose" → "mecanismo" da amiodarona).\n'
              '  static String _lastDrugTarget = \'\';\n'
              '\n'
              '  static List<Map<String, String>> buildThreadHistory({\n'
              '    required List<Map<String, String>> fullHistory,\n'
              '    required ClinicalThreadStatus status,\n'
              '    required bool isPlantaoMode,\n'
              '    String currentTaskLabel = \'\', // BUILD 304 [G1b]: label do intent atual\n'
              '  }) {\n'
              '    if (!isPlantaoMode) {\n'
              '      // BUILD STUDY-30TURN: same active Study chat keeps verbatim transport\n'
              '      // memory across task/subtask changes. The UI/local history stays intact;\n'
              '      // provider transport is bounded to the last 30 exchanges (60 entries).\n'
              '      _lastDrugTarget = _extractDrugFromHistory(fullHistory) ?? _lastDrugTarget;\n'
              '\n'
              '      final maxEntries = kMaxStudyTurns * 2;\n'
              '      final limited = fullHistory.length > maxEntries\n'
              '          ? fullHistory.sublist(fullHistory.length - maxEntries)\n'
              '          : List<Map<String, String>>.from(fullHistory);\n'
              '\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[STUDY_30TURN][HISTORY_SANITIZER] mode=estudo \'\n'
              '          \'strategy=verbatim_30_exchanges \'\n'
              '          \'sent=${limited.length}/${fullHistory.length} \'\n'
              '          \'taskLabel=$currentTaskLabel\',\n'
              '        );\n'
              '      }\n'
              '      return limited;\n'
              '    }\n'
              '\n'
              '    if (!status.isContinuation) {\n'
              '      // Novo thread → histórico vazio\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[HISTORY_SANITIZER] mode=plantao strategy=empty \'\n'
              '          \'sent=0 removed=${fullHistory.length} \'\n'
              '          \'reason=${status.reason}\',\n'
              '        );\n'
              '      }\n'
              '      return <Map<String, String>>[];\n'
              '    }\n'
              '\n'
              '    // PLANTAO_DEPENDENT_CLINICAL_FOLLOWUP_AND_CASE_ANCHOR_V1\n'
              '    //\n'
              '    // Continuation: manter a ancora do caso (primeiro par user+assistant)\n'
              '    // + os kMaxContinuationTurns pares mais recentes.\n'
              '    //\n'
              '    // Motivo: somente "ultimos pares" perde o caso-base depois de varias\n'
              '    // perguntas curtas ("por que?", "internacao?", "trombolise?" etc.).\n'
              '    // A ancora preserva os dados clinicos originais sem reabrir cross-case:\n'
              '    // newThread continua limpando todo o historico antes deste bloco.\n'
              '    final maxRecentEntries = kMaxContinuationTurns * 2;\n'
              '    final recent = fullHistory.length > maxRecentEntries\n'
              '        ? fullHistory.sublist(fullHistory.length - maxRecentEntries)\n'
              '        : List<Map<String, String>>.from(fullHistory);\n'
              '\n'
              '    final anchor = <Map<String, String>>[];\n'
              '    for (final entry in fullHistory) {\n'
              '      final role = entry[\'role\'];\n'
              '      if (anchor.isEmpty && role == \'user\') {\n'
              '        anchor.add(entry);\n'
              '        continue;\n'
              '      }\n'
              '      if (anchor.length == 1 && role == \'assistant\') {\n'
              '        anchor.add(entry);\n'
              '        break;\n'
              '      }\n'
              '    }\n'
              '\n'
              '    final anchored = <Map<String, String>>[];\n'
              '    final seen = <String>{};\n'
              '\n'
              '    void addUnique(Map<String, String> entry) {\n'
              '      final key = \'${entry[\'role\']}\\u0000${entry[\'content\']}\';\n'
              '      if (seen.add(key)) anchored.add(entry);\n'
              '    }\n'
              '\n'
              '    for (final entry in anchor) {\n'
              '      addUnique(entry);\n'
              '    }\n'
              '    for (final entry in recent) {\n'
              '      addUnique(entry);\n'
              '    }\n'
              '\n'
              '    if (kDebugMode) {\n'
              '      debugPrint(\n'
              '        \'[HISTORY_SANITIZER] mode=plantao \'\n'
              '        \'strategy=case_anchor_plus_recent \'\n'
              '        \'sent=${anchored.length} \'\n'
              '        \'anchor=${anchor.length} recent=${recent.length} \'\n'
              '        \'topic=${status.topic} \'\n'
              '        \'reason=${status.reason}\',\n'
              '      );\n'
              '    }\n'
              '    return anchored;\n'
              '  }\n'
              '\n'
              '  // ─────────────────────────────────────────────────────────────────────────\n'
              '  // reset() — limpa estado de instância do thread (chamado ao limpar chat\n'
              '  // ou logout). Pare resetar os campos estáticos de sessão (BUILD 304),\n'
              '  // chame também resetStaticState().\n'
              '  // ─────────────────────────────────────────────────────────────────────────\n'
              '  void reset() {\n'
              '    _activeTopic = \'\';\n'
              '    _activeThreadId = \'\';\n'
              '    _turnCount = 0;\n'
              '    _lastActivityMs = 0;\n'
              '    _threadStartQuery = \'\';\n'
              '  }\n'
              '\n'
              '  // ─────────────────────────────────────────────────────────────────────────\n'
              '  // resetStaticState() — Study/Plantao lifecycle cleanup.\n'
              '  //\n'
              '  // R9: TTL/taskLabel transport-reset state was removed. The remaining\n'
              '  // static helper is _lastDrugTarget, cleared on logout/new conversation.\n'
              '  // ─────────────────────────────────────────────────────────────────────────\n'
              '  static void resetStaticState() {\n'
              '    _lastDrugTarget = \'\'; // BUILD 307 [AMNESIA_COOLDOWN]: reset junto com label\n'
              '    debugPrint(\n'
              '      \'[STUDY_30TURN][STATIC_RESET] _lastDrugTarget="" \'\n'
              '      \'— static session state cleared (logout/new-conversation/hot-restart)\',\n'
              '    );\n'
              '  }\n'
              '\n'
              '  // ─────────────────────────────────────────────────────────────────────────\n'
              '  // _extractDrugFromHistory() — BUILD 307 [AMNESIA_COOLDOWN]\n'
              '  //\n'
              '  // Escaneia a mensagem de usuário mais recente no histórico em busca do\n'
              '  // fármaco-alvo primário (mesmo conjunto _kHighSpecificityDrugs usado em\n'
              '  // _detectPrimaryDrug). Retorna o primeiro match encontrado ou null.\n'
              '  //\n'
              '  // Usado exclusivamente em buildThreadHistory() para implementar o cooldown:\n'
              '  // se o fármaco-alvo persiste após mudança de intent, o wipe é suprimido.\n'
              '  // ─────────────────────────────────────────────────────────────────────────\n'
              '  static String? _extractDrugFromHistory(List<Map<String, String>> history) {\n'
              '    // Varre do fim para o início, busca a última mensagem do usuário\n'
              '    final lastUser = history.lastWhere(\n'
              '      (m) => (m[\'role\'] ?? \'\') == \'user\',\n'
              '      orElse: () => const {},\n'
              '    );\n'
              '    final content = (lastUser[\'content\'] ?? \'\').toLowerCase();\n'
              '    if (content.isEmpty) return null;\n'
              '    for (final drug in _kHighSpecificityDrugs) {\n'
              '      if (content.contains(drug)) return drug;\n'
              '    }\n'
              '    return null;\n'
              '  }\n'
              '\n'
              '  // ─────────────────────────────────────────────────────────────────────────\n'
              '  // primeFromHistory() — ORDEM 53 M1: reidrata thread a partir do histórico\n'
              '  // restaurado (ex: retorno do background, restore de sessão do DB).\n'
              '  //\n'
              '  // PROBLEMA RAIZ DA AMNÉSIA:\n'
              '  //   rebuildAiHistoryFromMessages() restaura _aiHistory (turnos de API), mas\n'
              '  //   _threadManager permanece com _activeTopic=\'\' (RAM-only, não persiste).\n'
              '  //   A próxima mensagem do usuário cai em `_activeTopic.isEmpty → first_message`\n'
              '  //   → ThreadAction.newThread → _aiHistory.clear() → contexto restaurado destruído.\n'
              '  //\n'
              '  // SOLUÇÃO: extrair a assinatura temática do último par user/assistant restaurado\n'
              '  // e injetar em _activeTopic/_lastActivityMs para que evaluate() classifique\n'
              '  // a próxima mensagem como continueThread (ou topic_shift real, se mudar de tema).\n'
              '  //\n'
              '  // [messages] — lista idêntica à passada em rebuildAiHistoryFromMessages()\n'
              '  //              formato: [{role:\'user\', content:\'...\'}, {role:\'assistant\', content:\'...\'}]\n'
              '  // ─────────────────────────────────────────────────────────────────────────\n'
              '  void primeFromHistory(List<Map<String, String>> messages) {\n'
              '    // Encontra a última mensagem do usuário no histórico restaurado\n'
              '    final userMsgs = messages\n'
              '        .where((m) => (m[\'role\'] ?? \'\') == \'user\')\n'
              '        .toList();\n'
              '    if (userMsgs.isEmpty) return; // sem contexto — mantém estado atual\n'
              '\n'
              '    final lastUserText = userMsgs.last[\'content\'] ?? \'\';\n'
              '    if (lastUserText.isEmpty) return;\n'
              '\n'
              '    final nowMs = DateTime.now().millisecondsSinceEpoch;\n'
