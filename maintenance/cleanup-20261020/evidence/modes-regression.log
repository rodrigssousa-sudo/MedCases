              '    \'midazolam\',\n'
              '    \'propofol\',\n'
              '    \'fentanil\',\n'
              '    \'ketamina\',\n'
              '    \'etomidato\',\n'
              '    \'succinilcolina\',\n'
              '    \'rocurônio\',\n'
              '    \'adrenalina\',\n'
              '    \'epinefrina\',\n'
              '    \'dopamina\',\n'
              '    \'dobutamina\',\n'
              '    \'nitroprussiato\',\n'
              '    \'nitroglicerina\',\n'
              '  ];\n'
              '\n'
              '  // ─────────────────────────────────────────────────────────────────────────\n'
              '  // evaluate() — avalia a nova query e retorna ClinicalThreadStatus\n'
              '  //\n'
              '  // Chamado em sendAiMessage() e buildAIAnswer() ANTES de montar o histórico.\n'
              '  // ─────────────────────────────────────────────────────────────────────────\n'
              '  ClinicalThreadStatus evaluate({\n'
              '    required String currentUserText,\n'
              '    required bool isPlantaoMode,\n'
              '    bool cameFromButton = false,\n'
              '  }) {\n'
              '    final now = DateTime.now().millisecondsSinceEpoch;\n'
              '    final q = currentUserText.trim().toLowerCase();\n'
              '    final wordCount = q.split(RegExp(r\'\\s+\')).where((w) => w.isNotEmpty).length;\n'
              '\n'
              '    // ── Timeout de inatividade → novo thread ───────────────────────────────\n'
              '    if (isPlantaoMode &&\n'
              '        _activeTopic.isNotEmpty &&\n'
              '        _lastActivityMs > 0 &&\n'
              '        (now - _lastActivityMs) > kThreadTimeoutMs) {\n'
              '      final oldTopic = _activeTopic;\n'
              '      _startNewThread(q, now);\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.newThread,\n'
              '        reason: \'inactivity_timeout\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // ── Thread vazio → inicia ──────────────────────────────────────────────\n'
              '    if (_activeTopic.isEmpty) {\n'
              '      _startNewThread(q, now);\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.newThread,\n'
              '        reason: \'first_message\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // ── Veio de botão clínico → sempre continuation ───────────────────────\n'
              '    if (cameFromButton) {\n'
              '      _turnCount++;\n'
              '      _lastActivityMs = now;\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[THREAD_MANAGER] mode=${isPlantaoMode ? "plantao" : "estudo"} \'\n'
              '          \'action=continue_thread reason=button_action \'\n'
              '          \'topic=$_activeTopic turnCount=$_turnCount\',\n'
              '        );\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.continueThread,\n'
              '        reason: \'button_action\',\n'
              '        topic: _activeTopic,\n'
              '        fromButton: true,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // ── ORDEM 33 — MANDATO 2: Termo clínico isolado de nova patologia ────────\n'
              '    // PRE-CHECK síncrono antes de qualquer regra de follow-up.\n'
              '    //\n'
              '    // BUG ALVO: "ICC" → wordCount=1 ≤ 3 → isTooShort=true → continueThread →\n'
              '    // history da Sertralina vaza para contexto de ICC → resposta mista.\n'
              '    //\n'
              '    // LÓGICA: se a query normalizada (trim + lowercase + sem pontuação) for\n'
              '    // EXATAMENTE um dos termos em _kIsolatedNewCaseTerms, ela é uma nova patologia\n'
              '    // isolada — independente de ser curta — e DEVE iniciar novo thread.\n'
              '    // Isso toma precedência sobre isTooShort e followUpPhrase.\n'
              '    //\n'
              '    // Também detecta termos de 1-2 palavras com fármaco diferente do ativo\n'
              '    // (ex: "Sertralina" quando thread ativo era "ICC").\n'
              '    final qNorm = q.replaceAll(RegExp(r\'[^\\w\\s]\'), \'\').trim();\n'
              '    final isIsolatedNewCase = _kIsolatedNewCaseTerms.contains(qNorm);\n'
              '\n'
              '    // Também detecta: query curta que contém OUTRO fármaco de alta especificidade\n'
              '    // diferente do fármaco ativo no thread (ex: thread=sertralina, query="ICC").\n'
              '    // Não se aplica: nenhum fármaco detectado → só isIsolatedNewCase decide.\n'
              '    final shortQueryDrugSwitch = (() {\n'
              '      if (!isPlantaoMode) return false;\n'
              '      final currentDrugShort = _detectPrimaryDrug(qNorm);\n'
              '      final activeDrugShort = _detectPrimaryDrug(_activeTopic.toLowerCase());\n'
              '      // Fármaco diferente do ativo → switch, mesmo query curta\n'
              '      return currentDrugShort != null &&\n'
              '          activeDrugShort != null &&\n'
              '          currentDrugShort != activeDrugShort;\n'
              '    })();\n'
              '\n'
              '    // R20 — repetir a MESMA patologia isolada no Modo Estudo não muda de tema.\n'
              '    // Corrige a sequência física: "Explicarme asma" -> "asma".\n'
              '    final incomingStudyTopic = !isPlantaoMode ? _extractTopicSignature(q) : \'\';\n'
              '    final sameStudyIsolatedTopic =\n'
              '        !isPlantaoMode &&\n'
              '        isIsolatedNewCase &&\n'
              '        incomingStudyTopic.isNotEmpty &&\n'
              '        incomingStudyTopic == _activeTopic;\n'
              '\n'
              '    if (sameStudyIsolatedTopic) {\n'
              '      _turnCount++;\n'
              '      _lastActivityMs = now;\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[R20][THREAD_MANAGER] mode=estudo \'\n'
              '          \'action=continue_thread reason=study_same_topic_isolated_term \'\n'
              '          \'topic=$_activeTopic turnCount=$_turnCount\',\n'
              '        );\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.continueThread,\n'
              '        reason: \'study_same_topic_isolated_term\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    if (isIsolatedNewCase || shortQueryDrugSwitch) {\n'
              '      final oldTopic = _activeTopic;\n'
              '      _startNewThread(q, now);\n'
              '      debugPrint(\n'
              '        \'[THREAD_MANAGER] mode=${isPlantaoMode ? "plantao" : "estudo"} \'\n'
              '        \'action=new_thread \'\n'
              '        \'reason=${isIsolatedNewCase ? "isolated_new_case_term" : "short_drug_switch"} \'\n'
              '        \'oldTopic=$oldTopic newTopic=$_activeTopic \'\n'
              '        \'query="$q"\',\n'
              '      );\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.newThread,\n'
              '        reason: isIsolatedNewCase\n'
              '            ? \'isolated_new_case_term\'\n'
              '            : \'short_drug_switch\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // ── Query muito curta / follow-up phrase → continuation ───────────────\n'
              '    final isFollowUpPhrase = _kFollowUpPhrases.any(\n'
              '      (p) => q == p || q.startsWith(\'$p \') || q.endsWith(\' $p\'),\n'
              '    );\n'
              '    final isTooShort = wordCount <= 3;\n'
              '    final shortContextualFollowUp = isContextualClinicalFollowUp(\n'
              '      currentUserText,\n'
              '    );\n'
              '    final shortFolded = q\n'
              '        .replaceAll(\'á\', \'a\')\n'
              '        .replaceAll(\'é\', \'e\')\n'
              '        .replaceAll(\'í\', \'i\')\n'
              '        .replaceAll(\'ó\', \'o\')\n'
              '        .replaceAll(\'ú\', \'u\')\n'
              '        .replaceAll(\'ü\', \'u\')\n'
              '        .replaceAll(\'ç\', \'c\');\n'
              '    final shortTokens = RegExp(\n'
              '      r\'[a-z0-9]+\',\n'
              '    ).allMatches(shortFolded).map((match) => match.group(0)!).toSet();\n'
              '    final shortStrongCardiacAlias = const <String>{\n'
              '      \'iamcsst\',\n'
              '      \'iamcest\',\n'
              '      \'iamssst\',\n'
              '      \'iamsest\',\n'
              '      \'stemi\',\n'
              '      \'nstemi\',\n'
              '    }.any(shortTokens.contains);\n'
              '    final shortThreadStartFolded = _threadStartQuery\n'
              '        .toLowerCase()\n'
              '        .replaceAll(\'á\', \'a\')\n'
              '        .replaceAll(\'é\', \'e\')\n'
              '        .replaceAll(\'í\', \'i\')\n'
              '        .replaceAll(\'ó\', \'o\')\n'
              '        .replaceAll(\'ú\', \'u\')\n'
              '        .replaceAll(\'ü\', \'u\')\n'
              '        .replaceAll(\'ç\', \'c\');\n'
              '    final shortCardiacCompatible =\n'
              '        shortStrongCardiacAlias &&\n'
              '        <String>[\n'
              '          \'torac\',\n'
              '          \'peito\',\n'
              '          \'precord\',\n'
              '          \'angin\',\n'
              '          \'coronar\',\n'
              '          \'cardiac\',\n'
              '          \'iam\',\n'
              '          \'sca\',\n'
              '        ].any(shortThreadStartFolded.contains);\n'
              '    final shortQueryClinicalSwitch =\n'
              '        isPlantaoMode &&\n'
              '        isTooShort &&\n'
              '        !isFollowUpPhrase &&\n'
              '        !shortContextualFollowUp &&\n'
              '        (shortStrongCardiacAlias ||\n'
              '            _kNewCaseSignals.any((signal) {\n'
              '              final foldedSignal = signal\n'
              '                  .replaceAll(\'á\', \'a\')\n'
              '                  .replaceAll(\'é\', \'e\')\n'
              '                  .replaceAll(\'í\', \'i\')\n'
              '                  .replaceAll(\'ó\', \'o\')\n'
              '                  .replaceAll(\'ú\', \'u\')\n'
              '                  .replaceAll(\'ü\', \'u\')\n'
              '                  .replaceAll(\'ç\', \'c\');\n'
              '              if (foldedSignal.contains(\' \')) {\n'
              '                return shortFolded.contains(foldedSignal);\n'
              '              }\n'
              '              return shortTokens.contains(foldedSignal);\n'
              '            })) &&\n'
              '        !_topicsOverlap(_activeTopic, q) &&\n'
              '        !shortCardiacCompatible;\n'
              '\n'
              '    if (shortQueryClinicalSwitch) {\n'
              '      final oldTopic = _activeTopic;\n'
              '      _startNewThread(q, now);\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[THREAD_MANAGER] mode=plantao \'\n'
              '          \'action=new_thread reason=short_clinical_switch \'\n'
              '          \'oldTopic=$oldTopic newTopic=$_activeTopic\',\n'
              '        );\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.newThread,\n'
              '        reason: \'short_clinical_switch\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    if (isTooShort || isFollowUpPhrase) {\n'
              '      _turnCount++;\n'
              '      _lastActivityMs = now;\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[THREAD_MANAGER] mode=${isPlantaoMode ? "plantao" : "estudo"} \'\n'
              '          \'action=continue_thread reason=${isFollowUpPhrase ? "followup_phrase" : "short_query"} \'\n'
              '          \'topic=$_activeTopic turnCount=$_turnCount\',\n'
              '        );\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.continueThread,\n'
              '        reason: isFollowUpPhrase ? \'followup_phrase\' : \'short_query\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // ── BUILD 300: MODO ESTUDO — memória 100% linear, sem HARD RESET por tópico ──\n'
              '    // No Modo Estudo (!isPlantaoMode) o estudo clínico expande e ramifica\n'
              '    // naturalmente. "Asma → broncodilatador → efeitos adversos" é continuação\n'
              '    // legítima mesmo sem overlap de palavras-chave. Nunca aplicar newThread por\n'
              '    // no_topic_overlap / new_case_signal / drug_switch no Modo Estudo.\n'
              '    // first_message e inactivity_timeout permanecem ativos em ambos os modos.\n'
              '    if (!isPlantaoMode) {\n'
              '      _turnCount++;\n'
              '      _lastActivityMs = now;\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[BUILD300][THREAD_MANAGER] mode=estudo \'\n'
              '          \'action=continue_thread reason=study_mode_memory_preserved \'\n'
              '          \'topic=$_activeTopic turnCount=$_turnCount\',\n'
              '        );\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.continueThread,\n'
              '        reason: \'study_mode_memory_preserved\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // ── Detecta mudança forte de tópico (APENAS Modo Plantão) ─────────────\n'
              '    // BUILD 305 [C2]: matching seguro por palavra inteira para tokens curtos.\n'
              '    // q já foi normalizado (lowercase, trim). Tokens com espaço (multi-palavra)\n'
              '    // usam contains direto. Tokens sem espaço ≤ 4 chars usam RegExp \\b para\n'
              '    // evitar falso positivo: \'iam\' em "vitamina", \'avc\' em "travca", etc.\n'
              '    // Tokens > 4 chars: contains é seguro (colisão léxica negligenciável).\n'
              '    final qNormSig = \' $q \'; // padding para word-boundary simplificado\n'
              '    bool matchesNewCaseSignal(String signal) {\n'
              '      if (signal == \'iam\' &&\n'
              '          RegExp(\n'
              '            r\'(^|[^a-z0-9])(?:iamcsst|iamcest|iamssst|iamsest|stemi|nstemi)([^a-z0-9]|$)\',\n'
              '          ).hasMatch(q)) {\n'
              '        return true;\n'
              '      }\n'
              '      if (signal.contains(\' \')) return q.contains(signal);\n'
              '      if (signal.length <= 4) return qNormSig.contains(\' $signal \');\n'
              '      return q.contains(signal);\n'
              '    }\n'
              '\n'
              '    final hasNewCaseSignal = _kNewCaseSignals.any(matchesNewCaseSignal);\n'
              '    final hasStrongNewCaseSignal = _kNewCaseSignals.any(\n'
              '      (signal) =>\n'
              '          !_kDemographicNewCaseSignals.contains(signal) &&\n'
              '          matchesNewCaseSignal(signal),\n'
              '    );\n'
              '\n'
              '    // Detecta fármaco novo diferente do thread ativo\n'
              '    final currentDrug = _detectPrimaryDrug(q);\n'
              '    final activeDrug = _detectPrimaryDrug(_activeTopic.toLowerCase());\n'
              '    final hasDrugSwitch =\n'
              '        currentDrug != null && activeDrug != null && currentDrug != activeDrug;\n'
              '\n'
              '    // Verifica overlap temático com o thread ativo\n'
              '    final topicOverlap = _topicsOverlap(_activeTopic, q);\n'
              '    final isContextualFollowUp = isContextualClinicalFollowUp(currentUserText);\n'
              '    final foldedCurrent = q\n'
              '        .replaceAll(\'á\', \'a\')\n'
              '        .replaceAll(\'é\', \'e\')\n'
              '        .replaceAll(\'í\', \'i\')\n'
              '        .replaceAll(\'ó\', \'o\')\n'
              '        .replaceAll(\'ú\', \'u\')\n'
              '        .replaceAll(\'ü\', \'u\')\n'
              '        .replaceAll(\'ç\', \'c\');\n'
              '    final richNarrativeFollowUp = _isRichClinicalNarrativeFollowUp(\n'
              '      foldedCurrent,\n'
              '    );\n'
              '    final hasAcuteCoronaryAlias = RegExp(\n'
              '      r\'(^|[^a-z0-9])(?:iamcsst|iamcest|iamssst|iamsest|stemi|nstemi)([^a-z0-9]|$)\',\n'
              '    ).hasMatch(foldedCurrent);\n'
              '    final threadStartFolded = _threadStartQuery\n'
              '        .toLowerCase()\n'
              '        .replaceAll(\'á\', \'a\')\n'
              '        .replaceAll(\'é\', \'e\')\n'
              '        .replaceAll(\'í\', \'i\')\n'
              '        .replaceAll(\'ó\', \'o\')\n'
              '        .replaceAll(\'ú\', \'u\')\n'
              '        .replaceAll(\'ü\', \'u\')\n'
              '        .replaceAll(\'ç\', \'c\');\n'
              '    final compatibleAcuteCoronaryProgression =\n'
              '        hasAcuteCoronaryAlias &&\n'
              '        <String>[\n'
              '          \'torac\',\n'
              '          \'peito\',\n'
              '          \'precord\',\n'
              '          \'angin\',\n'
              '          \'coronar\',\n'
              '          \'cardiac\',\n'
              '          \'iam\',\n'
              '          \'sca\',\n'
              '        ].any(threadStartFolded.contains);\n'
              '\n'
              '    // PLANTAO_EXPLICIT_CASE_BOUNDARY_PRECEDENCE_V1\n'
              '    //\n'
              '    // Fronteiras explícitas de caso/paciente são absolutas e precisam ser\n'
              '    // avaliadas antes de qualquer continuação por progressão diagnóstica\n'
              '    // compatível (ex.: IAMCEST -> IAMCEST em outro paciente).\n'
              '    final explicitCaseBoundaryEarly = <String>[\n'
              '      \'novo caso\',\n'
              '      \'nova paciente\',\n'
              '      \'novo paciente\',\n'
              '      \'outro paciente\',\n'
              '      \'outra paciente\',\n'
              '      \'mudar de caso\',\n'
              '      \'trocar de caso\',\n'
              '      \'nuevo caso\',\n'
              '      \'nuevo paciente\',\n'
              '      \'nueva paciente\',\n'
              '      \'otro paciente\',\n'
              '      \'otra paciente\',\n'
              '      \'cambiar de caso\',\n'
              '      \'new case\',\n'
              '      \'new patient\',\n'
              '      \'another patient\',\n'
              '    ].any(q.contains);\n'
              '\n'
              '    if (explicitCaseBoundaryEarly) {\n'
              '      final oldTopic = _activeTopic;\n'
              '      _startNewThread(q, now);\n'
              '\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\'[THREAD_MANAGER] mode=plantao \'\n'
              '            \'action=new_thread \'\n'
              '            \'reason=new_case_signal \'\n'
              '            \'oldTopic=$oldTopic newTopic=$_activeTopic\');\n'
              '      }\n'
              '\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.newThread,\n'
              '        reason: \'new_case_signal\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // Uma confirmação de IAM/STEMI pode ser a progressão natural de uma queixa\n'
              '    // torácica já ativa. Nesse caso preservamos o contexto; em qualquer tópico\n'
              '    // incompatível (por exemplo, fossa ilíaca) o alias forte continua abaixo\n'
              '    // para a regra canônica de newThread.\n'
              '    if (isPlantaoMode && compatibleAcuteCoronaryProgression && !hasDrugSwitch) {\n'
              '      _turnCount++;\n'
              '      _lastActivityMs = now;\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[THREAD_MANAGER] mode=plantao \'\n'
              '          \'action=continue_thread reason=compatible_diagnostic_progression \'\n'
              '          \'topic=$_activeTopic turnCount=$_turnCount\',\n'
              '        );\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.continueThread,\n'
              '        reason: \'compatible_diagnostic_progression\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // Resultados objetivos não precisam repetir o tópico. Narrativa clínica só\n'
              '    // vence um sinal sintomático de novo caso quando contém múltiplos marcadores\n'
              '    // de evolução/associação; isso evita transformar uma nova queixa isolada em\n'
              '    // continuação por acidente.\n'
              '    if (isContextualFollowUp &&\n'
              '        !hasDrugSwitch &&\n'
              '        (!hasStrongNewCaseSignal || topicOverlap || richNarrativeFollowUp)) {\n'
              '      _turnCount++;\n'
              '      _lastActivityMs = now;\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\n'
              '          \'[THREAD_MANAGER] mode=plantao \'\n'
              '          \'action=continue_thread reason=contextual_clinical_followup \'\n'
              '          \'topic=$_activeTopic turnCount=$_turnCount\',\n'
              '        );\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.continueThread,\n'
              '        reason: \'contextual_clinical_followup\',\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // PLANTAO_GLOBAL_SAME_TOPIC_SIGNAL_PRECEDENCE_V1\n'
              '    //\n'
              '    // Mencionar uma patologia/alias conhecido nao significa automaticamente\n'
              '    // "novo caso". O overlap semantico do tema ativo vence o sinal generico.\n'
              '    // Fronteiras explicitas de caso/paciente continuam absolutas.\n'
              '    final explicitCaseBoundary = <String>[\n'
              '      \'novo caso\',\n'
              '      \'nova paciente\',\n'
              '      \'novo paciente\',\n'
              '      \'outro paciente\',\n'
              '      \'outra paciente\',\n'
              '      \'mudar de caso\',\n'
              '      \'trocar de caso\',\n'
              '      \'nuevo caso\',\n'
              '      \'nuevo paciente\',\n'
              '      \'nueva paciente\',\n'
              '      \'otro paciente\',\n'
              '      \'otra paciente\',\n'
              '      \'cambiar de caso\',\n'
              '      \'new case\',\n'
              '      \'new patient\',\n'
              '      \'another patient\',\n'
              '    ].any(q.contains);\n'
              '\n'
              '    final shouldStartNewThread =\n'
              '        explicitCaseBoundary || hasDrugSwitch || !topicOverlap;\n'
              '\n'
              '    if (shouldStartNewThread) {\n'
              '      final oldTopic = _activeTopic;\n'
              '      _startNewThread(q, now);\n'
              '\n'
              '      final newThreadReason = explicitCaseBoundary ||\n'
              '              (hasNewCaseSignal && !topicOverlap)\n'
              '          ? \'new_case_signal\'\n'
              '          : (hasDrugSwitch ? \'drug_switch\' : \'no_topic_overlap\');\n'
              '\n'
              '      if (kDebugMode) {\n'
              '        debugPrint(\'[THREAD_MANAGER] mode=plantao \'\n'
              '            \'action=new_thread \'\n'
              '            \'reason=$newThreadReason \'\n'
              '            \'oldTopic=$oldTopic newTopic=$_activeTopic\');\n'
              '      }\n'
              '      return ClinicalThreadStatus(\n'
              '        action: ThreadAction.newThread,\n'
              '        reason: newThreadReason,\n'
              '        topic: _activeTopic,\n'
              '      );\n'
              '    }\n'
              '\n'
              '    // ── Mesmo tópico → continuation ───────────────────────────────────────\n'
              '    _turnCount++;\n'
              '    _lastActivityMs = now;\n'
              '    if (kDebugMode) {\n'
              '      debugPrint(\n'
              '        \'[THREAD_MANAGER] mode=${isPlantaoMode ? "plantao" : "estudo"} \'\n'
              '        \'action=continue_thread reason=same_topic \'\n'
              '        \'topic=$_activeTopic turnCount=$_turnCount\',\n'
              '      );\n'
              '    }\n'
              '    return ClinicalThreadStatus(\n'
              '      action: ThreadAction.continueThread,\n'
