              '    // O Context Timeout de 5 min (O53 M3) aplica-se na camada de AppProvider,\n'
              '    // não aqui — este timestamp previne apenas o timeout de 10min do ThreadManager.\n'
              '    _lastActivityMs = nowMs;\n'
              '    _threadStartQuery = lastUserText;\n'
              '\n'
              '    if (kDebugMode) {\n'
              '      debugPrint(\n'
              '        \'[THREAD_MANAGER] primeFromHistory: topic=$_activeTopic \'\n'
              '        \'turnCount=$_turnCount restoredPairs=$pairCount \'\n'
              '        \'— blindado contra first_message reset\',\n'
              '      );\n'
              '    }\n'
              '  }\n'
              '\n'
              '  // ── Getters públicos ──────────────────────────────────────────────────────\n'
              '  String get activeTopic => _activeTopic;\n'
              '  String get activeThreadId => _activeThreadId;\n'
              '  int get turnCount => _turnCount;\n'
              '  bool get hasActiveThread => _activeTopic.isNotEmpty;\n'
              '\n'
              '  // ── Helpers privados ──────────────────────────────────────────────────────\n'
              '\n'
              '  void _startNewThread(String query, int nowMs) {\n'
              '    _activeTopic = _extractTopicSignature(query);\n'
              '    _activeThreadId = \'${nowMs}_${_activeTopic.hashCode.abs()}\';\n'
              '    _turnCount = 1;\n'
              '    _lastActivityMs = nowMs;\n'
              '    _threadStartQuery = query;\n'
              '  }\n'
              '\n'
              '  // ── BUILD 305 [C1]: Stopwords PT-BR+ES — compartilhadas por _extract e _overlap ─\n'
              '  // Extraída para const estático para evitar alocação por chamada e garantir\n'
              '  // consistência na filtragem entre os dois métodos de análise temática.\n'
              '  static const _kStopwords = <String>{\n'
              '    // PT-BR\n'
              '    \'de\', \'da\', \'do\', \'e\', \'em\', \'o\', \'a\', \'os\', \'as\', \'um\', \'uma\',\n'
              '    \'para\', \'com\', \'no\', \'na\', \'por\', \'que\', \'se\', \'como\', \'qual\',\n'
              '    \'dos\', \'das\', \'mais\', \'mas\', \'seu\', \'sua\', \'este\', \'esta\',\n'
              '    // ES (sem duplicatas do PT)\n'
              '    \'el\', \'la\', \'los\', \'las\', \'un\', \'una\', \'en\', \'y\', \'es\', \'del\',\n'
              '    \'con\', \'cual\', \'sus\',\n'
              '  };\n'
              '\n'
              '  /// Extrai assinatura temática — BUILD 305 [C1]: take(4) → take(6).\n'
              '  ///\n'
              '  /// PROBLEMA ORIGINAL: take(4) capturava poucas palavras em queries longas.\n'
              '  /// Inversão sintática simples ("IC com congestão" vs "congestão no paciente\n'
              '  /// com IC") produzia assinaturas sem palavras em comum → falso newThread.\n'
              '  ///\n'
              '  /// SOLUÇÃO: take(6) amplia a janela de captura, aumentando a probabilidade\n'
              '  /// de sobreposição de palavras-chave clínicas em reformulações naturais.\n'
              '  // R20 — a intenção pedagógica não faz parte do nome do tema clínico.\n'
              '  static String _foldStudyPedagogicalText(String value) {\n'
              '    return value\n'
              '        .trim()\n'
              '        .toLowerCase()\n'
              '        .replaceAll(\'á\', \'a\')\n'
              '        .replaceAll(\'à\', \'a\')\n'
              '        .replaceAll(\'ã\', \'a\')\n'
              '        .replaceAll(\'â\', \'a\')\n'
              '        .replaceAll(\'é\', \'e\')\n'
              '        .replaceAll(\'ê\', \'e\')\n'
              '        .replaceAll(\'í\', \'i\')\n'
              '        .replaceAll(\'ó\', \'o\')\n'
              '        .replaceAll(\'ô\', \'o\')\n'
              '        .replaceAll(\'õ\', \'o\')\n'
              '        .replaceAll(\'ú\', \'u\')\n'
              '        .replaceAll(\'ü\', \'u\')\n'
              '        .replaceAll(\'ç\', \'c\')\n'
              '        .replaceAll(RegExp(r\'[^a-z0-9\\s]+\'), \' \')\n'
              '        .replaceAll(RegExp(r\'\\s+\'), \' \')\n'
              '        .trim();\n'
              '  }\n'
              '\n'
              '  static String _stripStudyPedagogicalLead(String value) {\n'
              '    var folded = _foldStudyPedagogicalText(value);\n'
              '    if (folded.isEmpty) return \'\';\n'
              '\n'
              '    // Wrapper de esclarecimento do R20 nunca pode virar identidade clínica.\n'
              '    if (folded.startsWith(\'modo estudio aclaracion minima\') ||\n'
