{
  "name": "medcases-functions",
  "description": "Cloud Functions — MedCases Pro",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node test/run_release_tests.js",
    "test:release:functions": "node test/run_release_tests.js --functions-only",
    "test:historical": "node test/run_release_tests.js --historical"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/kms": "5.7.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.0",
    "nodemailer": "10.0.10"
  },
  "private": true
}
