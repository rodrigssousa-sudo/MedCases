rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════════════════
    // HELPERS DE AUTENTICAÇÃO
    // ══════════════════════════════════════════════════════════════════════════

    function isAuthed() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // ── isAdmin() — BUILD 328 patch ──────────────────────────────────────────
    // Problema detectado: no Flutter Web (painel admin) o get(userPath()) falha
    // com permission-denied durante o cold-start / refresh do token de auth,
    // bloqueando admins legítimos em /admin_notifications e /global_push_campaigns.
    //
    // Estratégia de 3 camadas (sem I/O desnecessário):
    //   CAMADA 1 — Custom claim no JWT (zero I/O, sempre preferido):
    //     request.auth.token.role in ['admin','master']
    //     NOTA: só funciona depois de setCustomUserClaims() ser chamado.
    //           Se as Cloud Functions não setam claims, esta camada é no-op.
    //
    //   CAMADA 2 — get() do documento /users/{uid} com guard exists():
    //     Fallback seguro para apps que não usam custom claims.
    //     O exists() antes do get() evita exception por doc ausente.
    //
    //   CAMADA 3 — token.email_verified + request.auth.token.firebase.sign_in_provider:
    //     Não usada aqui; documentada para futuro hardening.
    //
    // IMPORTANTE: a Cloud Function onGlobalPushCampaignCreated usa Admin SDK e
    // portanto bypassa estas rules completamente (sem restrição de leitura).
    function isAdmin() {
      return isAuthed() && (
        // Camada 1: custom claim no JWT (zero Firestore reads)
        request.auth.token.get('role', '') in ['admin', 'master']
        ||
        // Camada 2: leitura do documento de perfil (fallback)
        // exists() previne exception quando o doc ainda não existe no cold-start
        (
          exists(userPath()) &&
          get(userPath()).data.get('role', '') in ['admin', 'master']
        )
      );
    }

    // ── isMaster() — verificação de role master separada ────────────────────
    // Usada onde somente master (não admin genérico) tem permissão.
    function isMaster() {
      return isAuthed() && (
        request.auth.token.get('role', '') == 'master'
        ||
        (
          exists(userPath()) &&
          get(userPath()).data.get('role', '') == 'master'
        )
      );
    }

    // BUILD 310 — Guard específico para campos do Ambassador Track.
    // Apenas master/admin podem escrever isPartner, partnerTitle, referralLink.
    function isWritingPartnerFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['isPartner', 'partnerTitle', 'referralLink']);
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CONFIGURAÇÃO GLOBAL DO APP
    // ══════════════════════════════════════════════════════════════════════════

    match /app_config/global {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /app_config/paid_budget {
      allow read, write: if isAdmin();
    }

    match /app_config/emailjs {
      allow read, write: if isAdmin();
    }

    match /app_config/maintenance {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ── Atualizações do app (changelog público) ──────────────────────────────
    match /app_updates/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // GUIAS CLÍNICAS E BIBLIOTECA
    // ══════════════════════════════════════════════════════════════════════════

    match /clinical_guides/{docId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /medical_guides/{document=**} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /biblioteca_clinica/{document=**} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /clinical_library/{document=**} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // SESSÕES DE IA — COLEÇÃO LEGADA RAIZ /sessions
    // ══════════════════════════════════════════════════════════════════════════

    match /sessions/{sessionId} {
      allow create: if isAuthed()
        && request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if isAuthed()
        && resource.data.userId == request.auth.uid;

      match /{allSubcollections=**} {
        allow read, write: if isAuthed();
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // USUÁRIOS
    // ══════════════════════════════════════════════════════════════════════════

    match /users/{userId} {
      allow get: if isAuthed()
        && (request.auth.uid == userId || isAdmin());

      allow list: if isAdmin();

      allow create: if isAuthed()
        && request.auth.uid == userId;

      allow update: if isAuthed() && (
        isAdmin()
        ||
        (request.auth.uid == userId && !isWritingPartnerFields())
      );

      allow delete: if isAdmin();

      // Subcoleções do usuário
      match /internaciones/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /clinical_histories/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /cases/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /favorites/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /prefs/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /ai_chat_history/{sessionId} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }
      match /ai_chat_history/{sessionId}/{rest=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /notes/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /fcmTokens/{tokenId} {
        allow read: if isAuthed()
          && (request.auth.uid == userId || isAdmin());

        allow create, update, delete: if isAuthed()
          && request.auth.uid == userId;
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // NOTIFICAÇÕES ADMINISTRATIVAS — BUILD 328 PATCH
    // ══════════════════════════════════════════════════════════════════════════
    //
    // CAUSA DO ERRO [ADMIN_NOTIF] permission-denied:
    //   A rule anterior dependia exclusivamente de isAdmin() para 'read',
    //   que internamente chama get(userPath()). No Flutter Web, durante o
    //   cold-start do painel admin, o Firestore avalia a rule ANTES do token
    //   de auth estar estabilizado, fazendo o get() falhar silenciosamente.
    //
    // SOLUÇÃO BUILD 328:
    //   'read'  → isAdmin() com fallback robusto (já corrigido no helper)
    //   'create'→ isAuthed() — app mobile injeta logs antes de o token admin
    //             se propagar; sem este relaxamento o app mobile quebraria.
    //   'update'→ isAdmin() — marcar como lido (readBy: arrayUnion)
    //   'delete'→ isAdmin()
    //
    // NOTA: a Cloud Function que grava admin_notifications usa Admin SDK e
    // bypassa estas rules — portanto o 'create' do Admin SDK nunca bate aqui.
    match /admin_notifications/{notificationId} {
      allow read:   if isAdmin();
      allow create: if isAuthed();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CAMPANHAS PUSH GLOBAIS — BUILD 328 PATCH
    // ══════════════════════════════════════════════════════════════════════════
    //
    // CAUSA DO ERRO "Erro ao disparar a campanha" / permission-denied:
    //   O Flutter Web chama:
    //     FirebaseFirestore.instance.collection('global_push_campaigns').add({
    //       'title':      title,
    //       'body':       body,
    //       'targetRole': 'all',
    //       'status':     'pending',
    //       'createdAt':  FieldValue.serverTimestamp(),
    //       'sentBy':     widget.currentAdmin.uid,
    //       'sentByEmail': widget.currentAdmin.email ?? '',
    //     })
    //
    //   A rule anterior exigia isAdmin() para 'create'. O isAdmin() interno
    //   faz get(userPath()) que falha no cold-start do painel Web, rejeitando
    //   o doc mesmo com o usuário sendo master/admin legítimo.
    //
    // SOLUÇÃO BUILD 328:
    //   'create': isAdmin() — mantido; mas o helper isAdmin() agora tem
    //     camada dupla robusta.
    //     Validação adicional:
    //       • status == 'pending'  — campo obrigatório para idempotência CF
    //       • sentBy == request.auth.uid — garante auditoria correta
    //         (o app já grava widget.currentAdmin.uid que == request.auth.uid)
    //
    //   'read':   isAdmin() — apenas admin/master pode listar campanhas
    //   'update': isAdmin() — admin pode editar campos de resultado
    //   'delete': isAdmin() — limpeza de campanhas antigas
    //
    // A Cloud Function onGlobalPushCampaignCreated usa Admin SDK e bypassa
    // estas rules completamente (pending→processing→done/error).
    match /global_push_campaigns/{campaignId} {
      allow read:   if isAdmin();

      allow create: if isAdmin()
                    && request.resource.data.get('status', '') == 'pending'
                    && request.resource.data.get('sentBy', '') == request.auth.uid;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // FCM QUEUE — BUILD 319
    // ══════════════════════════════════════════════════════════════════════════

    match /fcm_queue/{queueId} {
      allow read, write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PLANTÃO
    // ══════════════════════════════════════════════════════════════════════════

    match /meu_plantao/{document=**} {
      allow read, write: if isAuthed();
    }

    match /my_shifts/{document=**} {
      allow read, write: if isAuthed();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // HISTÓRIAS CLÍNICAS PÚBLICAS
    // ══════════════════════════════════════════════════════════════════════════

    match /public_histories/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // BUILD 310: SISTEMA DE INDICAÇÕES (influenciadores)
    // ══════════════════════════════════════════════════════════════════════════

    match /influencers/{slug} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }
  }
}
