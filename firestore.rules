rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // FUNÇÕES DE SEGURANÇA E ESCOPO (BUILD 226)
    // ─────────────────────────────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isApproved() {
      return isAuthed()
        && exists(userPath())
        && get(userPath()).data.status == 'approved';
    }

    function isAdmin() {
      return isApproved()
        && get(userPath()).data.role in ['admin', 'master'];
    }

    // ─────────────────────────────────────────────────────────────────────────
    // COLEÇÕES DE CONFIGURAÇÃO (APP_CONFIG)
    // ─────────────────────────────────────────────────────────────────────────
    match /app_config/global {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    match /app_config/paid_budget {
      allow read, write: if isAdmin();
    }

    match /app_config/emailjs {
      allow read, write: if isAdmin();
    }

    match /app_config/maintenance {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // GUIAS CLÍNICOS E SILENCIAMENTO DE LOGS FALLBACK
    // ─────────────────────────────────────────────────────────────────────────
    match /clinical_guides/{docId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Silencia os logs de erro de coleções de testes antigos/fallbacks do app
    match /medical_guides/{docId} { allow read: if isApproved(); }
    match /biblioteca_clinica/{docId} { allow read: if isApproved(); }
    match /clinical_library/{docId} { allow read: if isApproved(); }

    // ─────────────────────────────────────────────────────────────────────────
    // SESSÕES DE CHAT (/sessions/{sessionId})
    // ─────────────────────────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow create: if isApproved()
        && request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if isApproved()
        && resource.data.userId == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // CONTROLE DE USUÁRIOS (/users/{userId})
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // get: dono (qualquer status) + admin — permite tela de aguardando aprovação
      allow get: if isAuthed() && (request.auth.uid == userId || isAdmin());

      // list: somente admin — painel admin lista pending + approved + blocked
      allow list: if isAdmin();

      // create: qualquer usuário autenticado pode criar o próprio documento.
      // Não exige isApproved() — usuário recém-cadastrado ainda não tem doc.
      // Não impõe status=pending aqui: o app cria com status=approved (auto-aprovação).
      allow create: if isAuthed() && request.auth.uid == userId;

      // update:
      //   • Admin pode atualizar qualquer campo de qualquer usuário (aprovação, bloqueio).
      //   • O próprio usuário pode atualizar o seu documento independente de status
      //     (pending → approved via _autoApproveInBackground; atualização de perfil).
      //     Isso é necessário para que o auto-approve REST funcione sem loop de pending.
      allow update: if isAuthed() && (request.auth.uid == userId || isAdmin());

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // FCM TOKENS — subcoleção /users/{userId}/fcmTokens/{tokenId}
    // (PARTE 5 — BUILD 238)
    // Cada usuário gerencia seus próprios tokens; admin pode ler (para enviar push).
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read:             if (isAuthed() && request.auth.uid == userId) || isAdmin();
      allow create, update:   if isAuthed() && request.auth.uid == userId;
      allow delete:           if isAuthed() && request.auth.uid == userId;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // HISTÓRIAS CLÍNICAS PRIVADAS — /users/{userId}/clinical_histories/{histId}
    // BUILD 291: qualquer usuário autenticado dono da conta pode ler/escrever
    // o próprio histórico. Admin pode ler histórias de qualquer usuário (moderação).
    // Regra: request.auth.uid == userId (não requer isAdmin/isMaster).
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/clinical_histories/{histId} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
      allow read:        if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MEU PLANTÃO — /users/{userId}/internaciones/{sessionId}
    // BUILD 291: path confirmado como users/{uid}/internaciones (kInternacionesCollection).
    // Regra: request.auth.uid == userId — sem "if true", sem isAdmin gate.
    // Dono da conta lê e escreve; admin lê para suporte/moderação.
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/internaciones/{sessionId} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
      allow read:        if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // CASOS CUSTOMIZADOS — /users/{userId}/cases/{caseId}
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/cases/{caseId} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // FAVORITOS — /users/{userId}/favorites/{favId}
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/favorites/{favId} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PREFERÊNCIAS — /users/{userId}/prefs/{docId}
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/prefs/{docId} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // HISTÓRICO DE CHAT IA — /users/{userId}/ai_chat_history/{docId}
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/ai_chat_history/{docId} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // NOTAS — /users/{userId}/notes/{noteId}
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId}/notes/{noteId} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // NOTIFICAÇÕES ADMIN — /admin_notifications/{notificationId}
    // (PARTE 4 — BUILD 238 | atualizado BUILD 311)
    //
    // BUILD 311 — MUDANÇA SOBERANA:
    //   allow create: if isAuthed()
    //
    // MOTIVO ARQUITETURAL:
    //   O fluxo de cadastro agora é 100% automático (status=approved imediato).
    //   O celular do novo usuário grava o documento de alerta ANTES de qualquer
    //   Cloud Function ser invocada — isso garante entrega do push mesmo em
    //   ambientes com cold-start lento do servidor de funções.
    //
    //   Segurança mantida:
    //   • Leitura: SOMENTE admin/master (isAdmin guard inalterado).
    //   • O novo usuário pode CRIAR o documento de alerta (notificação de cadastro)
    //     mas NÃO pode ler, atualizar ou excluir outros documentos da coleção.
    //   • O conteúdo do documento é controlado pelo app e auditado pela Function.
    //   • Cloud Function (Admin SDK) ainda cria seu próprio documento em paralelo
    //     via onNewUserRegistered — dupla garantia de entrega.
    // ─────────────────────────────────────────────────────────────────────────
    match /admin_notifications/{notificationId} {
      allow read:   if isAdmin();
      allow create: if isAuthed(); // BUILD 311: novo usuário cria o alerta no boot
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // HISTÓRIAS PÚBLICAS — /public_histories/{storyId}
    //
    // LEITURA PÚBLICA IRRESTRITA — allow read: if true
    // Qualquer usuário (autenticado ou não) pode LISTAR e LER histórias públicas.
    //
    // MOTIVO: Histórias clínicas públicas são conteúdo educacional anonimizado.
    // Apple Section 5.1 / Google Play: sem PII associado à leitura.
    //
    // ⚠️  ATENÇÃO — IMPLANTAÇÃO OBRIGATÓRIA:
    // Este arquivo deve ser implantado no Firebase Console após qualquer alteração:
    //   firebase deploy --only firestore:rules
    //
    // Se o app móvel iOS exibir "Acesso negado" em public_histories, significa
    // que este arquivo não foi implantado. Execute o comando acima imediatamente.
    // ─────────────────────────────────────────────────────────────────────────
    match /public_histories/{storyId} {
      allow read: if true;
      allow write: if request.auth != null &&
                      (request.auth.uid == request.resource.data.authorId ||
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }
  }
}
