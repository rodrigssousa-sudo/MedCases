rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MEDCASES_SUPPORT_TICKET_RULES_V2_B_R1
    match /support_tickets/{ticketId} {
      allow create: if isAuthed()
        && request.resource.data.keys().hasOnly([
          'ticketId',
          'userId',
          'userEmail',
          'userName',
          'category',
          'categoryLabel',
          'rating',
          'message',
          'locale',
          'status',
          'priority',
          'platform',
          'sourceModule',
          'createdAt',
          'updatedAt',
          'assignedTo',
          'assignedToEmail',
          'adminReply',
          'adminReplyAt',
          'privacyNoticeVersion'
        ])
        && request.resource.data.ticketId == ticketId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.priority == 'normal'
        && request.resource.data.sourceModule == 'settings_support'
        && request.resource.data.privacyNoticeVersion == 'support-privacy-v1'
        && request.resource.data.assignedTo == ''
        && request.resource.data.assignedToEmail == ''
        && request.resource.data.adminReply == ''
        && request.resource.data.adminReplyAt == null
        && request.resource.data.locale in ['pt', 'es']
        && request.resource.data.category in [
          'support_help',
          'app_error',
          'suggestion',
          'drug_protocol',
          'subscription_account',
          'praise',
          'other'
        ]
        && request.resource.data.rating is int
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // User sees only own requests. Supervisor has triage read-only.
      allow read: if (
        isAuthed() && resource.data.userId == request.auth.uid
      ) || isAdmin() || isSupervisor();

      // Admin/Master can handle; Supervisor never mutates.
      allow update: if isAdmin();
      allow delete: if isMaster();
    }


    // ══════════════════════════════════════════════════════════════════════════
    // HELPERS DE AUTENTICAÇÃO — AUDIT 453 (Apple Pre-Submission Hardening)
    //
    // Proteções adicionadas:
    //   • isOwner(uid): garante que request.auth.uid == uid (proteção IDOR/
    //     injeção de parâmetro via URL). Substitui a checagem inline espalhada.
    //   • isTokenFresh(): bloqueia tokens com iat > 3600s (1h) para operações
    //     de escrita sensíveis (dados clínicos), evitando replay com token
    //     expirado que ainda não foi revogado pelo SDK Web.
    //   • hasVerifiedEmail(): garante email verificado para acesso a dados
    //     clínicos sensíveis (Nefrologia, Pediatria, Hepatologia).
    // ══════════════════════════════════════════════════════════════════════════

    function isAuthed() {
      return request.auth != null;
    }

    // AUDIT 453: owner guard — protege contra ataques de injeção de UID via
    // parâmetro de URL no Flutter Web (ex: ?uid=outro_usuario).
    // Garante formalmente que request.auth.uid == userId em TODA operação.
    function isOwner(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    // AUDIT 453: token freshness — bloqueia tokens com mais de 1 hora para
    // operações de escrita sensíveis. Previne replay com token ainda válido
    // mas emitido há muito tempo (ex.: sessão esquecida aberta no navegador).
    function isTokenFresh() {
      return request.auth != null
        && (request.time.toMillis() - request.auth.token.iat * 1000) < 3600000;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // ── isAdmin() — BUILD 328 patch ──────────────────────────────────────────
    // Problema detectado: no Flutter Web (painel admin) o get(userPath()) falha
    // com permission-denied durante o cold-start / refresh do token de auth,
    // bloqueando admins legítimos em /admin_notifications e /global_push_campaigns.
    //
    // Estratégia de 3 camadas (sem I/O desnecessário):
    //   CAMADA 1 — Custom claim no JWT (zero I/O, sempre preferido):
    //     request.auth.token.role in ['admin','master']
    //     NOTA: só funciona depois de setCustomUserClaims() ser chamado.
    //           Se as Cloud Functions não setam claims, esta camada é no-op.
    //
    //   CAMADA 2 — get() do documento /users/{uid} com guard exists():
    //     Fallback seguro para apps que não usam custom claims.
    //     O exists() antes do get() evita exception por doc ausente.
    //
    //   CAMADA 3 — token.email_verified + request.auth.token.firebase.sign_in_provider:
    //     Não usada aqui; documentada para futuro hardening.
    //
    // IMPORTANTE: a Cloud Function onGlobalPushCampaignCreated usa Admin SDK e
    // portanto bypassa estas rules completamente (sem restrição de leitura).
    function isAdmin() {
      return isAuthed() && (
        // Camada 1: custom claim no JWT (zero Firestore reads)
        request.auth.token.get('role', '') in ['admin', 'master']
        ||
        // Camada 2: leitura do documento de perfil (fallback)
        // exists() previne exception quando o doc ainda não existe no cold-start
        (
          exists(userPath()) &&
          get(userPath()).data.get('role', '') in ['admin', 'master']
        )
      );
    }

    // ── isMaster() — verificação de role master separada ────────────────────
    // Usada onde somente master (não admin genérico) tem permissão.
    function isMaster() {
      return isAuthed() && (
        request.auth.token.get('role', '') == 'master'
        ||
        (
          exists(userPath()) &&
          get(userPath()).data.get('role', '') == 'master'
        )
      );
    }

    // ADMIN_V2_ERRORS_FINAL_OPERATIONAL_CLOSURE_V1_RULES
    // Supervisor: leitura operacional limitada; nunca recebe permissão de mutação.
    function isSupervisor() {
      return isAuthed() && (
        request.auth.token.get('role', '') == 'supervisor'
        ||
        (
          exists(userPath()) &&
          get(userPath()).data.get('role', '') == 'supervisor'
        )
      );
    }

    // R20A — Client self-writes may never mint roles, staff flags, subscription
    // privileges or administrative/account approval state. Admin SDK is not
    // subject to Security Rules; privileged client updates still require isAdmin.
    function r20aProtectedProfileFields() {
      return [
        'role', 'permissions', 'permission', 'accessLevel',
        'isAdmin', 'isMaster', 'isSupervisor', 'isStaff',
        'isPartner', 'partnerTitle', 'referralLink',
        'billingEntitlementActive', 'billingEntitlementId', 'billingEntitlementExpiresAtMs',
        'subscriptionTier', 'subscriptionId',
        'subscriptionExpiresAt', 'subscriptionEndDate', 'subscription',
        'isPremium', 'premium', 'premiumAccess', 'premiumUntil',
        'premiumExpiresAt', 'entitlements', 'accessGranted',
        'aiCredits', 'credits', 'tokensBalance',
        'stripeCustomerId', 'appleOriginalTransactionId',
        'googlePurchaseToken', 'trialEndsAt', 'trialEndDate',
        'status', 'accountStatus', 'approvedBy', 'approvedAt',
        'blockedAt', 'blockedReason', 'isBlocked'
      ];
    }

    function r20aSafeSelfCreate() {
      return hasSafeInitialCommerceEntitlement()
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('plan', 'free') == 'free'
        && request.resource.data.get('subscriptionStatus', 'trial') == 'trial'
        && request.resource.data.get('status', 'approved') == 'approved'
        && request.resource.data.get('accountStatus', 'active') == 'active'
        && request.resource.data.get('approvedBy', 'system') == 'system'
        // R22D: legacy UserModel.toMap sends false/null partner defaults.
        // Accept only nonprivileged defaults; privileged values remain denied.
        && request.resource.data.get('isPartner', false) == false
        && request.resource.data.get('partnerTitle', null) == null
        && request.resource.data.get('referralLink', null) == null
        && !request.resource.data.keys().hasAny([
          'isAdmin', 'isMaster', 'isSupervisor', 'isStaff',
          'permissions', 'permission', 'accessLevel',
          'billingEntitlementActive', 'billingEntitlementId', 'billingEntitlementExpiresAtMs',
          'isPremium', 'premium', 'premiumAccess', 'premiumUntil',
          'premiumExpiresAt', 'entitlements', 'accessGranted',
          'aiCredits', 'credits', 'tokensBalance',
          'subscriptionTier', 'subscriptionId', 'subscriptionExpiresAt',
          'subscriptionEndDate', 'subscription',
          'stripeCustomerId', 'appleOriginalTransactionId',
          'googlePurchaseToken', 'trialEndsAt', 'trialEndDate',
          'blockedAt', 'blockedReason', 'isBlocked'
        ]);
    }

    function r20aSafeSelfUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(r20aProtectedProfileFields())
        && (!isWritingCommerceEntitlementFields() || isSafeClientCommerceEntitlementRepair());
    }

    // R22A: a standard admin may maintain ordinary profiles, including the
    // existing user->supervisor workflow, but may never grant master/admin,
    // mutate privileged aliases or change/delete an existing master profile.
    // Master actions remain gated by the existing isMaster() helper. These
    // Firestore rules do not validate or inventory production custom claims.
    function r22aSafeAdminUpdate() {
      return isMaster() || (
        resource.data.get('role', 'user') != 'master'
        && request.resource.data.get('role', 'user') != 'master'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isMaster', 'isAdmin', 'isSupervisor', 'isStaff',
          'permissions', 'permission', 'accessLevel',
          'entitlements', 'accessGranted'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || (
            resource.data.get('role', 'user') in ['user', 'supervisor']
            && request.resource.data.get('role', 'user') in ['user', 'supervisor']
          )
        )
      );
    }

    // A nested /sessions document inherits the UID from its parent. Never
    // allow every authenticated user to read or alter another user's content.
    function r22aSessionOwner(sessionId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/sessions/$(sessionId))
        && get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('userId', '') == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CONFIGURAÇÃO GLOBAL DO APP
    // ══════════════════════════════════════════════════════════════════════════

    match /app_config/global {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /app_config/paid_budget {
      allow read, write: if isAdmin();
    }

    // ADMIN_V2_COMMUNICATION_FINAL_OPERATIONAL_CLOSURE_V1_RULES
    match /app_config/emailjs {
      allow read: if isAdmin() || isSupervisor();
      allow write: if isMaster();
    }

    // ADMIN_V2_SETTINGS_MASTER_RULE_HARDENING_V1
    // Estado global de manutenção: leitura preservada; mutação somente Master.
    match /app_config/maintenance {
      allow read: if isAuthed();
      allow write: if isMaster();
    }

    // ── Atualizações do app (changelog público) ──────────────────────────────
    // Novidades do app são públicas para leitura, mas publicação é Master-only.
    match /app_updates/{document=**} {
      allow read: if true;
      allow write: if isMaster();
    }


    // ADMIN_AUDIT_LOG_V1
    // Escrita exclusivamente server-side via Admin SDK.
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }


    // ADMIN_V2_AI_COSTS_V2_RULES — Erros & Saúde
    match /admin_incidents/{document=**} {
      allow read: if isAdmin() || isSupervisor();
      allow create, update, delete: if isAdmin();
    }


    // ADMIN_V2_AI_COSTS_V2_RULES — Comunicação
    match /email_campaigns/{document=**} {
      allow read: if isAdmin() || isSupervisor();
      allow create, update, delete: if isAdmin();
    }


    // ADMIN_V2_AI_COSTS_V2_RULES — telemetria server-side.

    // ADMIN_V2_403_METRICS_RULES_CLOSURE_V1
    // Executive/Admin dashboard aggregate metrics: read-only for Admin/Master.
    match /admin_metrics/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Error-center aggregates: read-only for Admin/Master.
    match /admin_error_metrics/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Billing/revenue aggregates are restricted to Master.
    match /admin_billing_metrics/{document=**} {
      allow read: if isMaster();
      allow create, update, delete: if false;
    }

    match /admin_ai_metrics/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }


    // ADMIN_AI_TELEMETRY_PRODUCER_V1
    match /admin_ai_usage_events/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }


    // ADMIN_V2_AI_COSTS_V2_RULES — controle GPT server-side.
    match /app_config/ai_control {
      allow read: if isAdmin();
      allow write: if false;
    }


    // ══════════════════════════════════════════════════════════════════════════
    // GUIAS CLÍNICAS E BIBLIOTECA
    // ══════════════════════════════════════════════════════════════════════════

    match /clinical_guides/{docId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /medical_guides/{document=**} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /biblioteca_clinica/{document=**} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /clinical_library/{document=**} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // SESSÕES DE IA — COLEÇÃO LEGADA RAIZ /sessions
    // ══════════════════════════════════════════════════════════════════════════

    match /sessions/{sessionId} {
      allow create: if isAuthed()
        && request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if isAuthed()
        && resource.data.userId == request.auth.uid;

      // BUILD 332: Admin/Master podem listar e ler sessões para sincronismo
      // no Painel Master — loadAiSessions usa /users/{uid}/ai_chat_history
      // mas esta coleção raiz é lida pelo painel de suporte.
      allow read, list: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if r22aSessionOwner(sessionId) || isAdmin();
        allow create, update, delete: if r22aSessionOwner(sessionId);
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // SESSÕES DE IA — COLEÇÃO PRINCIPAL /users/{uid}/ai_chat_history
    // BUILD 332: Regras explícitas para permitir leitura admin/master
    // na subcoleção que loadAiSessions() usa, resolvendo o erro
    // "[cloud_firestore/permission-denied] Missing or insufficient permissions"
    // ao executar loadAiSessions no Painel Master (cross-user read).
    // ══════════════════════════════════════════════════════════════════════════
    //
    // CAUSA DO ERRO:
    //   loadAiSessions(uid) chama:
    //     _db.collection('users').doc(uid).collection('ai_chat_history')
    //       .orderBy('updatedAt', descending: true).limit(20).get()
    //
    //   A rule em /users/{userId}/ai_chat_history/{sessionId} exige
    //   request.auth.uid == userId. Quando o Master lê sessões de OUTRO
    //   usuário via Painel Master (uid ≠ request.auth.uid), a condição falha
    //   e o Firestore retorna permission-denied.
    //
    // SOLUÇÃO BUILD 332:
    //   Adicionar || isAdmin() explícito na subcoleção ai_chat_history
    //   para que Master/Admin possam listar sessões de qualquer usuário.
    //   A regra existente em /users/{userId} já tinha isAdmin() mas
    //   subcoleções precisam de regra própria no Firestore Security Rules.
    //
    // NOTA: as regras em /users/{userId}/ai_chat_history abaixo JÁ têm
    //   isAdmin(). Esta seção documenta o diagnóstico e a confirmação
    //   de que o path correto é a subcoleção (não /sessions raiz).
    // ══════════════════════════════════════════════════════════════════════════

    // ══════════════════════════════════════════════════════════════════════════
    // USUÁRIOS
    // ══════════════════════════════════════════════════════════════════════════

    // MEDCASES_COMMERCE_F10_2_SERVER_MANAGED_ENTITLEMENT_RULES_V1_B_R0
    //
    // Canonical commerce authority:
    //   Firebase UID -> server-managed subscription fields -> MCC1.
    // Client writes may create/repair FREE/TRIAL defaults only.
    // RevenueCat synchronization will use a trusted server/Admin SDK writer.
    function isWritingCommerceEntitlementFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'plan',
        'subscriptionStatus',
        'subscriptionProvider',
        'subscriptionStore',
        'subscriptionProductId',
        'subscriptionEntitlementId',
        'subscriptionExpiresAt',
        'subscriptionUpdatedAt',
        'subscriptionEventId',
        'revenueCatAppUserId',
        'revenueCatEnvironment'
      ]);
    }

    function hasSafeInitialCommerceEntitlement() {
      return request.resource.data.get('plan', 'free') == 'free'
        && request.resource.data.get('subscriptionStatus', 'trial') == 'trial'
        && !request.resource.data.keys().hasAny([
          'subscriptionProvider',
          'subscriptionStore',
          'subscriptionProductId',
          'subscriptionEntitlementId',
          'subscriptionExpiresAt',
          'subscriptionUpdatedAt',
          'subscriptionEventId',
          'revenueCatAppUserId',
          'revenueCatEnvironment'
        ]);
    }

    function isSafeClientCommerceEntitlementRepair() {
      return (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan'])
          || (
            resource.data.get('plan', '__missing__') == '__missing__'
            && request.resource.data.get('plan', '') == 'free'
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriptionStatus'])
          || (
            resource.data.get('subscriptionStatus', '__missing__') == '__missing__'
            && request.resource.data.get('subscriptionStatus', '') == 'trial'
          )
        )
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'subscriptionProvider',
          'subscriptionStore',
          'subscriptionProductId',
          'subscriptionEntitlementId',
          'subscriptionExpiresAt',
          'subscriptionUpdatedAt',
          'subscriptionEventId',
          'revenueCatAppUserId',
          'revenueCatEnvironment'
        ]);
    }

    match /users/{userId} {
      allow get: if isAuthed()
        && (request.auth.uid == userId || isAdmin());

      allow list: if isAdmin();

      // R20A: roles and privileged fields must be provisioned by trusted
      // administration; a new client profile is always an ordinary user.
      allow create: if isOwner(userId) && r20aSafeSelfCreate();

      allow update: if isAuthed() && (
        (isAdmin() && r22aSafeAdminUpdate())
        ||
        (isOwner(userId) && r20aSafeSelfUpdate())
      );

      // Standard admins cannot delete master accounts. Master keeps the
      // pre-existing administrative ability to delete any profile.
      allow delete: if isMaster() || (
        isAdmin() && resource.data.get('role', 'user') != 'master'
      );

      // Subcoleções do usuário
      // AUDIT 453: isOwner() substitui checagem inline — proteção IDOR explícita
      match /internaciones/{document=**} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isTokenFresh();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Histórias Clínicas Privadas (Aba Ferramentas / Histórico Pessoal)
      // AUDIT 453: isOwner() + isTokenFresh() para writes — proteção IDOR completa
      match /clinical_histories/{document=**} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isTokenFresh();
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /cases/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /favorites/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /prefs/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      // AUDIT 453 — ai_chat_history: regras explícitas + isOwner() + isTokenFresh()
      //
      // PROTEÇÕES (Apple Guideline 5.1.1 — Data Collection & Storage):
      //   • read/list: apenas o owner ou admin — NUNCA outro uid (anti-IDOR)
      //   • create: owner + token fresco (< 1h) + campo uid == request.auth.uid
      //             (bloqueia injeção de uid alheio no payload)
      //   • update: owner + token fresco — impede escrita cruzada de sessões
      //   • delete: owner ou admin
      //
      // RACE CONDITION FIX (Apple Guideline 2.1 — Performance):
      //   As regras do Firestore avaliam request.auth no momento da requisição.
      //   Se o SDK Web ainda não propagou o token, request.auth será null e
      //   a rule retorna false → permission-denied.
      //   O fix correto está no cliente (AUDIT 453 _waitForAuth()), mas as rules
      //   aqui servem como última barreira de segurança formal.
      //
      // NOTA BUILD 332: isAdmin() mantido para leitura cross-user no Painel Master.
      match /ai_chat_history/{sessionId} {
        allow read, list: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
          && isTokenFresh()
          && request.resource.data.get('uid', '') == request.auth.uid;

        allow update: if isOwner(userId) && isTokenFresh();

        allow delete: if isOwner(userId) || isAdmin();
      }
      match /ai_chat_history/{sessionId}/{rest=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) && isTokenFresh();
      }

      // ════════════════════════════════════════════════════════════════════════
      // MICRO-BUILD 462E-A.5.3.7.3.2.5.1: Canonical AI session index
      // Schema v2 — path: users/{uid}/ai_sessions/{sessionId}
      //
      // LEAST-PRIVILEGE POLICY:
      //   • read:   strict owner-only (no cross-user reads, not even admin —
      //             clinical conversation content is private by design).
      //   • create: owner must be auth'd; payload uid == auth.uid and
      //             payload sessionId == path sessionId (anti-injection).
      //   • update: same owner/payload invariants plus resource.data.uid
      //             check (prevents UID swap on existing doc).
      //   • delete: owner-only soft delete (isDeleted flag) — hard delete
      //             allowed but must be owner.
      //
      // Exchange sub-documents (immutable, one per message exchange):
      //   path: …/ai_sessions/{sessionId}/exchanges/{requestId}
      //   • create: owner + uid/sessionId/requestId all anchored to their
      //             path-segment counterparts (anti-replay, anti-injection).
      //   • update: owner + same three-field invariant.
      //   • delete: owner-only.
      // ════════════════════════════════════════════════════════════════════════
      match /ai_sessions/{sessionId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.uid == userId
          && request.resource.data.sessionId == sessionId;

        allow update: if isOwner(userId)
          && resource.data.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.sessionId == sessionId;

        allow delete: if isOwner(userId);

        match /exchanges/{requestId} {
          allow read: if isOwner(userId);

          allow create: if isOwner(userId)
            && request.resource.data.uid == userId
            && request.resource.data.sessionId == sessionId
            && request.resource.data.requestId == requestId;

          allow update: if isOwner(userId)
            && resource.data.uid == userId
            && request.resource.data.uid == userId
            && request.resource.data.sessionId == sessionId
            && request.resource.data.requestId == requestId;

          allow delete: if isOwner(userId);
        }
      }

      match /notes/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /fcmTokens/{tokenId} {
        allow read: if isAuthed()
          && (request.auth.uid == userId || isAdmin());

        allow create, update, delete: if isAuthed()
          && request.auth.uid == userId;
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // NOTIFICAÇÕES ADMINISTRATIVAS — BUILD 328 PATCH
    // ══════════════════════════════════════════════════════════════════════════
    //
    // CAUSA DO ERRO [ADMIN_NOTIF] permission-denied:
    //   A rule anterior dependia exclusivamente de isAdmin() para 'read',
    //   que internamente chama get(userPath()). No Flutter Web, durante o
    //   cold-start do painel admin, o Firestore avalia a rule ANTES do token
    //   de auth estar estabilizado, fazendo o get() falhar silenciosamente.
    //
    // SOLUÇÃO BUILD 328:
    //   'read'  → isAdmin() com fallback robusto (já corrigido no helper)
    //   'create'→ isAuthed() — app mobile injeta logs antes de o token admin
    //             se propagar; sem este relaxamento o app mobile quebraria.
    //   'update'→ isAdmin() — marcar como lido (readBy: arrayUnion)
    //   'delete'→ isAdmin()
    //
    // NOTA: a Cloud Function que grava admin_notifications usa Admin SDK e
    // bypassa estas rules — portanto o 'create' do Admin SDK nunca bate aqui.
    match /admin_notifications/{notificationId} {
      allow read:   if isAdmin() || isSupervisor();
      // Cloud Functions/Admin SDK bypass rules. Client-side arbitrary
      // notifications from ordinary authenticated users are forbidden.
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CAMPANHAS PUSH GLOBAIS — BUILD 328 PATCH
    // ══════════════════════════════════════════════════════════════════════════
    //
    // CAUSA DO ERRO "Erro ao disparar a campanha" / permission-denied:
    //   O Flutter Web chama:
    //     FirebaseFirestore.instance.collection('global_push_campaigns').add({
    //       'title':      title,
    //       'body':       body,
    //       'targetRole': 'all',
    //       'status':     'pending',
    //       'createdAt':  FieldValue.serverTimestamp(),
    //       'sentBy':     widget.currentAdmin.uid,
    //       'sentByEmail': widget.currentAdmin.email ?? '',
    //     })
    //
    //   A rule anterior exigia isAdmin() para 'create'. O isAdmin() interno
    //   faz get(userPath()) que falha no cold-start do painel Web, rejeitando
    //   o doc mesmo com o usuário sendo master/admin legítimo.
    //
    // SOLUÇÃO BUILD 328:
    //   'create': isAdmin() — mantido; mas o helper isAdmin() agora tem
    //     camada dupla robusta.
    //     Validação adicional:
    //       • status == 'pending'  — campo obrigatório para idempotência CF
    //       • sentBy == request.auth.uid — garante auditoria correta
    //         (o app já grava widget.currentAdmin.uid que == request.auth.uid)
    //
    //   'read':   isAdmin() — apenas admin/master pode listar campanhas
    //   'update': isAdmin() — admin pode editar campos de resultado
    //   'delete': isAdmin() — limpeza de campanhas antigas
    //
    // A Cloud Function onGlobalPushCampaignCreated usa Admin SDK e bypassa
    // estas rules completamente (pending→processing→done/error).
    match /global_push_campaigns/{campaignId} {
      allow read:   if isAdmin() || isSupervisor();

      allow create: if isAdmin()
                    && request.resource.data.get('status', '') == 'pending'
                    && request.resource.data.get('sentBy', '') == request.auth.uid;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // FCM QUEUE — BUILD 319
    // ══════════════════════════════════════════════════════════════════════════

    match /fcm_queue/{queueId} {
      allow read, write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PLANTÃO
    // ══════════════════════════════════════════════════════════════════════════

    match /meu_plantao/{document=**} {
      allow read, write: if isAuthed();
    }

    match /my_shifts/{document=**} {
      allow read, write: if isAuthed();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // HISTÓRIAS CLÍNICAS PÚBLICAS
    // ══════════════════════════════════════════════════════════════════════════
    //
    // MODELO DE PERMISSÃO (consolidado pós-auditoria):
    //   • read:   público (sem autenticação) — leitura do feed aberto
    //   • create: qualquer usuário autenticado + token fresco (< 1h)
    //             → moderação posterior via Admin/Master
    //   • update, delete: apenas Admin/Master — moderação e controle total
    //
    // SEGURANÇA: sem isOwner() no create pois a coleção é pública por design.
    // O campo 'authorUid' no payload deve ser validado pela Cloud Function
    // ou pelo cliente antes de exibir (não é dado clínico privado).
    match /public_histories/{documentId} {
      allow read: if true;
      allow create: if isAuthed() && isTokenFresh();
      allow update, delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // BUILD 310: SISTEMA DE INDICAÇÕES (influenciadores)
    // ══════════════════════════════════════════════════════════════════════════

    // Testimonials: private submissions, separately approved public snapshots.
    // One submission per authenticated account; no emails or private profiles in public feed.
    function testimonialValid(d, uid) {
      return d.keys().hasAll(['uid','displayName','profession','text','photo','consent',
          'consentVersion','status','featured','createdAt','updatedAt'])
        && d.keys().hasOnly(['uid','displayName','profession','text','photo','consent',
          'consentVersion','status','featured','createdAt','updatedAt'])
        && d.uid == uid
        && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 80
        && d.profession is string && d.profession.size() > 0 && d.profession.size() <= 80
        && d.text is string && d.text.size() >= 10 && d.text.size() <= 1000
        && d.photo is string && d.photo.size() <= 180000
        && (d.photo == '' || d.photo.matches('data:image/(png|jpeg);base64,[A-Za-z0-9+/=]+'))
        && d.consent == true && d.consentVersion == 'public-testimonial-v1'
        && d.status in ['pending','approved','rejected'] && d.featured is bool
        && (d.status == 'approved' || d.featured == false)
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function testimonialOwner(uid) {
      return isAuthed() && request.auth.uid == uid
        && exists(userPath()) && get(userPath()).data.get('status', '') == 'approved';
    }
    function testimonialPublicationMatches(uid, d) {
      let s = getAfter(/databases/$(database)/documents/testimonial_submissions/$(uid)).data;
      return d.keys().hasAll(['displayName','profession','text','photo','featured','updatedAt'])
        && d.keys().hasOnly(['displayName','profession','text','photo','featured','updatedAt'])
        && s.status == 'approved' && s.consent == true
        && d.displayName == s.displayName && d.profession == s.profession
        && d.text == s.text && d.photo == s.photo && d.featured == s.featured
        && d.updatedAt == s.updatedAt;
    }
    function testimonialPublicGone(uid) {
      return !existsAfter(/databases/$(database)/documents/testimonial_public/$(uid));
    }
    match /testimonial_submissions/{uid} {
      allow get: if (isAuthed() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if testimonialOwner(uid) && testimonialValid(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'pending' && request.resource.data.featured == false
        && testimonialPublicGone(uid);
      allow update: if testimonialValid(request.resource.data, uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && ((testimonialOwner(uid) && request.resource.data.status == 'pending'
            && request.resource.data.featured == false && testimonialPublicGone(uid))
          || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status','featured','updatedAt'])
            && ((request.resource.data.status == 'approved'
              && testimonialPublicationMatches(uid,
                getAfter(/databases/$(database)/documents/testimonial_public/$(uid)).data))
              || (request.resource.data.status != 'approved' && testimonialPublicGone(uid)))));
      allow delete: if ((isAuthed() && request.auth.uid == uid) || isAdmin())
        && testimonialPublicGone(uid);
    }
    match /testimonial_public/{uid} {
      allow read: if true;
      allow create, update: if isAdmin() && testimonialPublicationMatches(uid, request.resource.data);
      allow delete: if isAdmin() || (isAuthed() && request.auth.uid == uid);
    }

    match /influencers/{slug} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }
  }
}
