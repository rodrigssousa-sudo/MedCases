rules_version = '2';

// ══════════════════════════════════════════════════════════════════════════════
// MedCases Pro — Firestore Security Rules
// Versão: 2026-06-24d (Build 226 — isAdmin robusto + match explícito app_config)
//
// MECANISMO DE IDENTIDADE ADMIN:
//  O app usa Firestore users/{uid}.role (string: 'master' | 'admin').
//  Custom claims Firebase Auth NUNCA são setadas no app.
//
//  isAdmin() usa get() inline no documento users/{uid}:
//    1. isAuthed() — usuário autenticado
//    2. exists() — documento users/{uid} existe
//    3. .data.role in ['admin','master'] — campo role diretamente
//
// RESUMO DE ACESSO:
//  • users/{uid}/**         → admin: read+write tudo; usuário: só o próprio
//  • clinical_guides        → leitura: PÚBLICA; escrita: admin
//  • public_histories       → leitura: PÚBLICA; escrita: dono; delete: dono|admin
//  • app_config/global      → leitura/escrita: admin only (Gemini Key + flags)
//  • app_config/emailjs     → leitura/escrita: admin only
//  • app_config/paid_budget → leitura/escrita: admin only (Build 226)
//  • app_config/maintenance → leitura: autenticado; escrita: admin
//  • app_updates            → leitura: autenticado; escrita: admin
//  • email_campaigns        → admin only
// ══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── isAuthed ─────────────────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    // ── isOwner ──────────────────────────────────────────────────────────────
    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // ── isAdmin ──────────────────────────────────────────────────────────────
    // Verifica Firestore users/{uid}.role via get() inline.
    // Sem funções auxiliares — evita ambiguidade de contexto no Rules engine.
    // Equivale a: UserModel.isAdmin = role=='admin' || role=='master'
    function isAdmin() {
      return isAuthed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'master'];
    }

    // ── Perfis de usuário ────────────────────────────────────────────────────
    // Admin: leitura e escrita completa incluindo list (pageSize queries)
    // Usuário: get/create/update só no próprio documento
    match /users/{userId} {
      allow read, write: if isAdmin();
      allow get:         if isOwner(userId);
      allow create:      if isOwner(userId);
      allow update:      if isOwner(userId);

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();

        match /{subSubDoc} {
          allow read, write: if isOwner(userId) || isAdmin();
        }
      }
    }

    // ── Biblioteca Clínica ───────────────────────────────────────────────────
    match /clinical_guides/{guideId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Histórias Clínicas Públicas ──────────────────────────────────────────
    match /public_histories/{historyId} {
      allow read: if true;

      allow create: if isAuthed()
        && request.resource.data.get('authorUid', '') == request.auth.uid;

      allow update: if isAuthed()
        && resource.data.get('authorUid', '') == request.auth.uid;

      allow delete: if isAuthed() && (
        resource.data.get('authorUid', '') == request.auth.uid || isAdmin()
      );
    }

    // ── Configuração Global — matches explícitos por documento ────────────────
    //
    // IMPORTANTE: cada documento tem seu próprio match explícito.
    // Evita ambiguidade do engine ao avaliar condições sobre {docId} variável.
    //
    // app_config/global: contém Gemini API Key + geminiPaidEnabled
    //   NUNCA expor a usuários comuns. Admin lê e escreve.
    match /app_config/global {
      allow read, write: if isAdmin();
    }

    // app_config/emailjs: configuração EmailJS
    match /app_config/emailjs {
      allow read, write: if isAdmin();
    }

    // app_config/paid_budget: contadores de custo Gemini Paid (Build 226)
    //   GEMINI_PAID_API_KEY nunca aqui — fica no Firebase Secret.
    //   Cloud Function geminiPaidProxy usa Service Account (acesso implícito).
    match /app_config/paid_budget {
      allow read, write: if isAdmin();
    }

    // app_config/maintenance: qualquer autenticado pode ler; escrita: admin
    match /app_config/maintenance {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // Wildcard: bloqueia qualquer outro documento de app_config não listado
    match /app_config/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Notificações de Atualização ──────────────────────────────────────────
    match /app_updates/{docId} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── Campanhas de Email ───────────────────────────────────────────────────
    match /email_campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    // ── Legado: config/emailjs ───────────────────────────────────────────────
    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Bloqueio padrão ──────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
