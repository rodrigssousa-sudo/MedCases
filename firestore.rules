rules_version = '2';

// ══════════════════════════════════════════════════════════════════════════════
// MedCases Pro — Firestore Security Rules
// Versão: 2026-06-24c (Build 226 — Fix isAdmin circular + simplificado)
//
// MECANISMO DE IDENTIDADE ADMIN:
//  O app usa Firestore users/{uid}.role (string: 'master' | 'admin').
//  Custom claims Firebase Auth NUNCA são setadas no app.
//
//  isAdmin() usa get() inline no documento users/{uid}.
//  IMPORTANTE: sem funções auxiliares intermediárias (userDoc/userDocPath)
//  para evitar ambiguidade no Rules engine ao avaliar match /users/{uid}.
//
// RESUMO DE ACESSO:
//  • users/{uid}/**         → admin: read+write tudo; usuário: só o próprio
//  • clinical_guides        → leitura: PÚBLICA; escrita: admin
//  • public_histories       → leitura: PÚBLICA; escrita: dono; delete: dono|admin
//  • app_config/*           → manutenção: autenticado; resto: admin only
//  • app_updates            → leitura: autenticado; escrita: admin
//  • email_campaigns        → admin only
// ══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── isAuthed ─────────────────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    // ── isOwner ──────────────────────────────────────────────────────────────
    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // ── isAdmin ──────────────────────────────────────────────────────────────
    // Verifica users/{uid}.role diretamente via get() inline.
    //
    // Decisões de design:
    //  • get() inline (sem função auxiliar) — evita dupla avaliação do engine
    //  • exists() antes do get() — evita erro se o doc não existir
    //  • .data.role (acesso direto, sem .get()) — máxima compatibilidade
    //  • SEM checar status — reduz condições que podem falhar silenciosamente
    //    (o app já bloqueia usuários não-aprovados na camada Flutter)
    //
    // Equivale a: UserModel.isAdmin = role == 'admin' || role == 'master'
    function isAdmin() {
      return isAuthed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'master'];
    }

    // ── Perfis de usuário ────────────────────────────────────────────────────
    // Admin/master: leitura e escrita completa (inclui list — pageSize queries)
    // Usuário: get/create/update apenas no próprio documento
    match /users/{userId} {
      allow read, write: if isAdmin();
      allow get:         if isOwner(userId);
      allow create:      if isOwner(userId);
      allow update:      if isOwner(userId);

      // Sub-coleções (casos, favoritos, histórico IA, prefs…)
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();

        match /{subSubDoc} {
          allow read, write: if isOwner(userId) || isAdmin();
        }
      }
    }

    // ── Biblioteca Clínica ───────────────────────────────────────────────────
    match /clinical_guides/{guideId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Histórias Clínicas Públicas ──────────────────────────────────────────
    match /public_histories/{historyId} {
      allow read: if true;

      allow create: if isAuthed()
        && request.resource.data.get('authorUid', '') == request.auth.uid;

      allow update: if isAuthed()
        && resource.data.get('authorUid', '') == request.auth.uid;

      allow delete: if isAuthed() && (
        resource.data.get('authorUid', '') == request.auth.uid || isAdmin()
      );
    }

    // ── Configuração Global (app_config) ─────────────────────────────────────
    // app_config/global     → Gemini API Key + geminiPaidEnabled — NUNCA expor
    // app_config/emailjs    → configuração EmailJS — admin only
    // app_config/paid_budget→ contadores Gemini Paid — admin only (Build 226)
    // app_config/maintenance→ flag de manutenção — qualquer autenticado pode LER
    //
    // GEMINI_PAID_API_KEY nunca armazenada aqui — fica no Firebase Secret.
    // Cloud Function geminiPaidProxy usa Service Account (acesso implícito).
    match /app_config/{docId} {
      // maintenance: leitura para qualquer autenticado
      allow read:  if docId == 'maintenance' && isAuthed();

      // global, emailjs, paid_budget: leitura restrita a admin
      allow read:  if docId in ['global', 'emailjs', 'paid_budget'] && isAdmin();

      // Toda escrita: apenas admin
      allow write: if isAdmin();
    }

    // ── Notificações de Atualização ──────────────────────────────────────────
    match /app_updates/{docId} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── Campanhas de Email ───────────────────────────────────────────────────
    match /email_campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    // ── Legado: config/emailjs ───────────────────────────────────────────────
    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Bloqueio padrão ──────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
