rules_version = '2';

// ══════════════════════════════════════════════════════════════════════════════
// MedCases Pro — Firestore Security Rules
// Versão: 2026-06-24 (Build 226 — Fix permission-denied admin toggle)
//
// RESUMO DE ACESSO:
//  • users/{uid}/**         → leitura/escrita: apenas o próprio usuário
//  • clinical_guides        → leitura: PÚBLICA (conteúdo educativo — isPublished=true filtrado no client)
//  • public_histories       → leitura: qualquer usuário autenticado
//                           → escrita: apenas o dono do documento (uid == authorUid)
//  • app_config/global      → leitura: apenas admin/master (contém Gemini API Key — NUNCA expor publicamente)
//  • app_config/maintenance → leitura: qualquer autenticado; escrita: apenas admin/master
//  • app_config/paid_budget → leitura/escrita: apenas admin/master (Build 226: contadores custo Gemini Paid)
//  • app_updates/current    → leitura: qualquer autenticado; escrita: apenas admin/master
//  • email_campaigns        → leitura/escrita: apenas admin/master
//
// MECANISMO DE IDENTIDADE ADMIN (Build 226 Fix):
//  O app identifica admin/master via Firestore users/{uid}.role (valores: 'master', 'admin').
//  NÃO usa Firebase Auth custom claims — custom claims NUNCA são setadas no app.
//  isAdmin() usa get() no documento users/{uid} para verificar o campo role.
//  Fallback mantido para custom claims (futuro), mas nunca será acionado no estado atual.
// ══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────

    // Usuário autenticado (qualquer status)
    function isAuthed() {
      return request.auth != null;
    }

    // Usuário é o dono do recurso
    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // ── isAdmin(): verifica se o usuário tem role admin ou master ────────────
    // MECANISMO PRINCIPAL: lê users/{uid}.role no Firestore (campo string).
    // O app usa UserRole enum: 'master' e 'admin' → isAdmin=true.
    // UserModel.isAdmin = role == UserRole.admin || role == UserRole.master
    // NÃO usa custom claims — elas nunca são setadas no app atual.
    // Fallback por custom claims mantido para compatibilidade futura.
    //
    // IMPORTANTE: get() conta como uma leitura de documento adicional por regra.
    // É seguro usar aqui pois app_config só é acessado por admin, não em massa.
    function isAdmin() {
      return isAuthed() && (
        // ── Abordagem 1 (PRIMÁRIA): Firestore users/{uid}.role ───────────────
        // Corresponde exatamente a UserModel.isAdmin no Dart:
        //   bool get isAdmin => role == UserRole.admin || role == UserRole.master
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'master'] ||

        // ── Abordagem 2 (FALLBACK): custom claims Firebase Auth ───────────────
        // Nunca acionado no estado atual (custom claims não são setadas).
        // Mantido para futura migração gradual para custom claims se necessário.
        request.auth.token.get('isAdmin', false) == true ||
        request.auth.token.get('role', '') in ['admin', 'master']
      );
    }

    // ── Perfis de usuário ────────────────────────────────────────────────────
    // Leitura/escrita: apenas o próprio usuário
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Sub-coleções do usuário (casos, favoritos, histórico IA, prefs, etc.)
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid);

        // Sub-sub-coleções (ex: users/{uid}/prefs/settings)
        match /{subSubDoc} {
          allow read, write: if isOwner(uid);
        }
      }
    }

    // ── Biblioteca Clínica (clinical_guides) ─────────────────────────────────
    // Leitura: PÚBLICA — sem autenticação (conteúdo educativo, biblioteca clínica).
    // A Biblioteca deve abrir e mostrar guias mesmo antes do login.
    // O filtro isPublished=true é responsabilidade do cliente (query SDK/REST).
    // Escrita: apenas admin
    match /clinical_guides/{guideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Histórias Clínicas Públicas (public_histories) ───────────────────────
    // Leitura: PÚBLICA — sem autenticação (conteúdo educativo, visível para todos)
    // As 26+ histórias públicas devem ser visíveis mesmo antes do login.
    // Criação/atualização: usuário autenticado cujo uid == authorUid no documento
    // Deleção: o próprio autor OU admin (moderação)
    match /public_histories/{historyId} {
      allow read: if true;

      // Criação: authorUid no payload deve coincidir com o uid do solicitante
      allow create: if isAuthed()
        && request.resource.data.get('authorUid', '') == request.auth.uid;

      // Atualização: apenas o autor pode editar sua própria HC
      allow update: if isAuthed()
        && resource.data.get('authorUid', '') == request.auth.uid;

      // Deleção: autor OU admin (moderação)
      allow delete: if isAuthed() && (
        resource.data.get('authorUid', '') == request.auth.uid ||
        isAdmin()
      );
    }

    // ── Configuração Global do App (app_config) ───────────────────────────────
    // ATENÇÃO: app_config/global contém a Gemini API Key.
    // NUNCA permitir leitura pública. Apenas admin lê e escreve.
    // app_config/maintenance → qualquer autenticado pode LER (saber se há manutenção)
    // app_config/paid_budget → APENAS admin lê e escreve (Build 226)
    //   Contém: dailyCount, estimatedPaidCostUsd, contadores por usuário/hora.
    //   A GEMINI_PAID_API_KEY NUNCA é armazenada aqui — fica no Firebase Secret.
    //   A Cloud Function geminiPaidProxy lê e escreve este documento server-side.
    match /app_config/{docId} {

      // maintenance: leitura pública autenticada (todos precisam saber)
      allow read: if docId == 'maintenance' && isAuthed();

      // global, emailjs e paid_budget: apenas admin
      // paid_budget: contém contadores de custo — NUNCA expor a usuários comuns
      allow read: if (docId == 'global' || docId == 'emailjs' || docId == 'paid_budget') && isAdmin();

      // Qualquer escrita em app_config: apenas admin
      // (a Cloud Function usa Service Account — tem acesso implícito de admin)
      allow write: if isAdmin();
    }

    // ── Notificações de Atualização (app_updates) ────────────────────────────
    // Leitura: qualquer usuário autenticado (saber sobre novas versões)
    // Escrita: apenas admin
    match /app_updates/{docId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ── Campanhas de Email ────────────────────────────────────────────────────
    // Apenas admin lê e escreve
    match /email_campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    // ── Legado: config/emailjs (path antigo) ─────────────────────────────────
    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Bloquear tudo que não foi explicitamente declarado ───────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
