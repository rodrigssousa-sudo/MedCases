rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers de autenticação ──────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // isAdmin: aceita tanto custom claims (JWT) quanto campo role no documento.
    // Dual-check garante compatibilidade com Web (REST/idToken) e nativo (SDK).
    function isAdmin() {
      return isAuthed() && (
        request.auth.token.role in ['admin', 'master'] ||
        (
          exists(userPath()) &&
          get(userPath()).data.role in ['admin', 'master']
        )
      );
    }

    // BUILD 310 — Guard específico para campos do Ambassador Track.
    // Apenas master/admin podem escrever isPartner, partnerTitle, referralLink.
    // O próprio usuário pode atualizar outros campos do seu documento (lang,
    // darkMode, etc.) mas NÃO pode elevar os campos de parceria a si mesmo.
    function isWritingPartnerFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['isPartner', 'partnerTitle', 'referralLink']);
    }

    // ── Configuração global do app ────────────────────────────────────────────
    match /app_config/global {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /app_config/paid_budget {
      allow read, write: if isAdmin();
    }

    match /app_config/emailjs {
      allow read, write: if isAdmin();
    }

    match /app_config/maintenance {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ── Atualizações do app (changelog público) ──────────────────────────────
    match /app_updates/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Guias clínicas e biblioteca ──────────────────────────────────────────
    match /clinical_guides/{docId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /medical_guides/{document=**} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /biblioteca_clinica/{document=**} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /clinical_library/{document=**} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ── Sessões de IA — coleção legada raiz /sessions ────────────────────────
    // NOTA: o app usa /users/{uid}/ai_chat_history (subcoleção do usuário).
    // Este bloco mantém compatibilidade com docs migrados ou versões antigas.
    match /sessions/{sessionId} {
      allow create: if isAuthed()
        && request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if isAuthed()
        && resource.data.userId == request.auth.uid;

      match /{allSubcollections=**} {
        allow read, write: if isAuthed();
      }
    }

    // ── Usuários ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isAuthed()
        && (request.auth.uid == userId || isAdmin());

      allow list: if isAdmin();

      allow create: if isAuthed()
        && request.auth.uid == userId;

      // UPDATE: usuário pode atualizar seu próprio documento EXCETO campos
      // do Ambassador Track (isPartner, partnerTitle, referralLink), que são
      // soberania exclusiva de admin/master (BUILD 310).
      allow update: if isAuthed() && (
        // Admin/master: permissão irrestrita (inclui campos partner)
        isAdmin()
        ||
        // Próprio usuário: permitido apenas se NÃO estiver alterando campos partner
        (request.auth.uid == userId && !isWritingPartnerFields())
      );

      allow delete: if isAdmin();

      // Subcoleções do usuário
      match /internaciones/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /clinical_histories/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /cases/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /favorites/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /prefs/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      // ── BUILD 318: ai_chat_history — histórico de sessões IA cross-device ───
      // Caminho usado por FirestoreService._userAiHistory():
      //   /users/{userId}/ai_chat_history/{sessionId}
      //
      // CAUSA DO ERRO "[BUILD300] loadAiSessions permission-denied":
      //   O wildcard {document=**} não cobria leituras com orderBy + limit
      //   quando o token Firebase ainda estava em refresh (cold-start Android/iOS).
      //   Regras com {document=**} aplicam-se a TODAS as profundidades de subcoleção,
      //   mas a query com Source.server no get() exige que o claim de auth esteja
      //   presente ANTES da avaliação da rule — não apenas "eventually".
      //
      // SOLUÇÃO: regra explícita em dois níveis:
      //   {sessionId}         → operações em documento único (upsert, delete, get)
      //   {sessionId}/{rest=**} → subcoleções futuras (sem quebrar compatibilidade)
      // Ambos os níveis usam request.auth.uid == userId (uid-lock estrito).
      // isAdmin() mantido para acesso do painel de suporte.
      match /ai_chat_history/{sessionId} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }
      match /ai_chat_history/{sessionId}/{rest=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /notes/{document=**} {
        allow read, write: if isAuthed()
          && (request.auth.uid == userId || isAdmin());
      }

      match /fcmTokens/{tokenId} {
        allow read: if isAuthed()
          && (request.auth.uid == userId || isAdmin());

        allow create, update, delete: if isAuthed()
          && request.auth.uid == userId;
      }
    }

    // ── Notificações administrativas (BUILD 311 CORREÇÃO) ────────────────────
    match /admin_notifications/{notificationId} {
      allow read:   if isAdmin();
      allow create: if isAuthed(); // Liberado para o celular do novo usuário injetar o log no boot do cadastro automático
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Campanhas Push Globais (BUILD 311b) ───────────────────────────────────
    // Motor de envio em lote de notificações push para todos os usuários.
    // Somente administradores (admin/master) podem criar ou ler campanhas.
    // Usuários comuns não têm acesso algum a esta coleção.
    match /global_push_campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    // ── Plantão ──────────────────────────────────────────────────────────────
    match /meu_plantao/{document=**} {
      allow read, write: if isAuthed();
    }

    match /my_shifts/{document=**} {
      allow read, write: if isAuthed();
    }

    // ── Histórias clínicas públicas ──────────────────────────────────────────
    match /public_histories/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── BUILD 310: Sistema de Indicações (influenciadores) ───────────────────
    // Coleção `influencers` gerenciada pelo ReferralService.
    // Leitura: qualquer admin/master (painel Indicações).
    // Escrita: apenas admin/master (criar slug, deletar influenciador).
    // Usuários comuns não têm acesso a esta coleção.
    match /influencers/{slug} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }
  }
}
